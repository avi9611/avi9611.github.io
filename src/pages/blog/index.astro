---
import Layout from "../../layouts/Layout.astro";
import Navigation from "../../components/Navigation.astro";
import Footer from "../../components/Footer.astro";

// Sample blog posts - in a real scenario, these would come from a CMS or markdown files
const blogPosts = [
  {
    id: "getting-started-with-astro",
    title: "Designing fast marketing sites with Astro",
    excerpt:
      "A practical walkthrough of how I think about performance, content structure, and maintainable front-end delivery for fast websites.",
    date: "2025-01-15",
    category: "Frontend Delivery",
    readTime: "5 min read",
    image: "/images/project-placeholder.jpg",
  },
  {
    id: "mern-stack-best-practices",
    title: "What makes a backend feel production ready",
    excerpt:
      "Notes on API contracts, maintainable service boundaries, deployment workflows, and the small decisions that improve reliability over time.",
    date: "2025-01-10",
    category: "Backend Systems",
    readTime: "8 min read",
    image: "/images/project-placeholder.jpg",
  },
  {
    id: "azure-fundamentals-guide",
    title: "Using AI tooling without lowering code quality",
    excerpt:
      "How tools like Claude Code, Codex, and Copilot can speed up delivery while still keeping engineering standards high.",
    date: "2025-01-05",
    category: "AI Workflow",
    readTime: "10 min read",
    image: "/images/project-placeholder.jpg",
  },
];
---

<Layout
  title="Writing Desk - Avinash Neralakatte"
  description="Notes and upcoming writing from Avinash Neralakatte on backend systems, frontend delivery, AI-assisted engineering workflows, and product implementation."
>
  <Navigation />

  <main class="pt-24 pb-24 min-h-screen">
    <div class="max-w-[1400px] mx-auto px-4 md:px-8">
      <div class="text-center mb-16">
        <a
          href="/"
          class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.2em] text-ink-light hover:text-ink mb-6"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Back to portfolio
        </a>
        <h1 class="section-header inline-block">Writing Desk</h1>
        <p class="section-lede mt-4">
          A place for architecture notes, build lessons, and practical thoughts from shipping real software.
        </p>
      </div>

      <div class="paper-card p-8 md:p-10 text-center mb-12">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full border border-ink/20 bg-white/45 flex items-center justify-center">
          <svg
            class="w-8 h-8 text-ink-light"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"
            ></path>
          </svg>
        </div>
        <h2 class="font-display text-4xl font-semibold mb-3">Writing is on the way</h2>
        <p class="text-lg text-ink/75 max-w-2xl mx-auto leading-relaxed">
          I’m shaping this section around production backend work, implementation patterns, performance decisions, and the practical use of AI in engineering delivery.
        </p>
      </div>

      <h2 class="font-display text-4xl font-semibold mb-6">Upcoming topics</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          blogPosts.map((post) => (
            <article class="paper-card overflow-hidden group">
              <div class="relative h-48 overflow-hidden border-b border-ink/10">
                <img
                  src={post.image}
                  alt={post.title}
                  class="w-full h-full object-cover grayscale-[0.1] contrast-105 transition-transform duration-500 group-hover:scale-[1.02]"
                  loading="lazy"
                />
                <div class="absolute top-3 left-3">
                  <span class="tag-chip">
                    {post.category}
                  </span>
                </div>
              </div>

              <div class="p-6">
                <div class="flex items-center gap-3 text-ink-light text-sm mb-3">
                  <span>
                    {new Date(post.date).toLocaleDateString("en-US", {
                      month: "short",
                      day: "numeric",
                      year: "numeric",
                    })}
                  </span>
                  <span>•</span>
                  <span>{post.readTime}</span>
                </div>

                <h3 class="font-display text-3xl font-semibold mb-3 leading-tight group-hover:text-[var(--color-accent)] transition-colors">
                  {post.title}
                </h3>

                <p class="text-base text-ink/75 leading-relaxed">
                  {post.excerpt}
                </p>
              </div>
            </article>
          ))
        }
      </div>

      <div class="mt-16 paper-card p-8 md:p-10 text-center">
        <h2 class="font-display text-4xl font-semibold mb-3">Follow along</h2>
        <p class="text-lg text-ink/75 mb-6 max-w-2xl mx-auto leading-relaxed">
          Until writing goes live here, LinkedIn and GitHub are the best places to follow new work and updates.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="https://www.linkedin.com/in/avinash-n-a99387286/"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-news inline-flex items-center justify-center gap-2"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
              ></path>
            </svg>
            <span>Follow on LinkedIn</span>
          </a>
          <a
            href="https://github.com/avi9611"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-news btn-news-secondary inline-flex items-center justify-center gap-2"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
              ></path>
            </svg>
            <span>Follow on GitHub</span>
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
