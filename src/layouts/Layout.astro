---
import "../styles/global.css";
import personal from "../data/personal.json";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = `Avinash Neralakatte (Avinash N) - Full Stack & GenAI Developer | FastAPI, Next.js, PostgreSQL Expert | Bangalore`,
  description = `Avinash Neralakatte (Avinash N) is a Full Stack & Generative AI Developer specializing in FastAPI, Next.js, MERN Stack, PostgreSQL, Docker, and Cloud platforms. MCA graduate with production experience building scalable AI-driven web applications in Kochi and Bangalore, India. Explore my portfolio, projects, and technical expertise.`,
  image = "/images/avinash.jpg",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// JSON-LD Structured Data for SEO
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Avinash Neralakatte",
  alternateName: ["Avinash N", "Avinash N Neralakatte"],
  additionalName: "Neralakatte",
  jobTitle: "Full Stack & Generative AI Developer",
  description: personal.tagline,
  url: Astro.site?.toString() || "https://avi9611.github.io",
  image: `${Astro.site}images/avinash.jpg`,
  sameAs: [
    personal.social.github,
    personal.social.linkedin,
    personal.social.leetcode,
    personal.social.hackerrank,
    personal.social.geeksforgeeks,
    personal.social.instagram,
    personal.social.dailydev,
  ],
  address: {
    "@type": "PostalAddress",
    addressLocality: "Kochi, Bangalore",
    addressRegion: "Kerala, Karnataka",
    addressCountry: "IN",
  },
  email: personal.email,
  telephone: personal.phone,
  knowsAbout: [
    "Full Stack Development",
    "Generative AI",
    "FastAPI",
    "Next.js",
    "React.js",
    "Node.js",
    "Python",
    "TypeScript",
    "JavaScript",
    "MERN Stack",
    "PostgreSQL",
    "MongoDB",
    "Docker",
    "Cloud Computing",
    "Azure",
    "AWS",
    "API Development",
    "Backend Development",
    "Frontend Development",
    "Web Development",
    "Clean Architecture",
    "System Design",
  ],
  alumniOf: {
    "@type": "EducationalOrganization",
    name: "Visvesvaraya Technological University",
  },
  hasOccupation: {
    "@type": "Occupation",
    name: "Full Stack Engineer",
    occupationLocation: {
      "@type": "City",
      name: "Bangalore, India",
    },
    estimatedSalary: {
      "@type": "MonetaryAmountDistribution",
      name: "Full-time Employed",
    },
  },
  worksFor: {
    "@type": "Organization",
    name: "Hybrid Interactive Consultancy LLP",
  },
};

// Breadcrumb Schema for better navigation
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: Astro.site?.toString() || "https://avi9611.github.io",
    },
    ...(Astro.url.pathname !== "/"
      ? [
          {
            "@type": "ListItem",
            position: 2,
            name: title.split("|")[0].trim(),
            item: canonicalURL.toString(),
          },
        ]
      : []),
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={personal.name} />
    <meta
      name="keywords"
      content="Avinash Neralakatte, Avinash N, Avinash N Neralakatte, Full Stack Developer, GenAI Developer, Generative AI, FastAPI, Next.js, React, Node.js, PostgreSQL, MongoDB, Docker, Python, TypeScript, JavaScript, MERN Stack, Cloud Computing, Azure, AWS, MCA Graduate, Software Engineer, Web Developer, Backend Developer, Frontend Developer, API Development, Kochi Developer, Bangalore Developer, India, Portfolio, Clean Code, Production Experience, Scalable Applications, AI-Driven Applications, Neralakatte"
    />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/jpeg" href="/images/avinash.jpg" />
    <link rel="apple-touch-icon" href="/images/avinash.jpg" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${Astro.site}${image}`} />
    <meta property="og:site_name" content={`${personal.name} Chronicle`} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={`${Astro.site}${image}`} />

    <!-- Additional SEO -->
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow" />
    <meta name="theme-color" content="#121212" />
    <meta name="language" content="English" />
    <meta name="revisit-after" content="7 days" />
    <meta name="rating" content="General" />
    <meta name="geo.region" content="IN-KA" />
    <meta name="geo.placename" content="Bangalore, Kochi" />
    <meta name="geo.position" content="12.9716;77.5946" />
    <meta name="ICBM" content="12.9716, 77.5946" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Playfair+Display:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbSchema)}
    />
    <style is:global>
      /* Paper Grain Animation */
      @keyframes paper-noise {
        0%,
        100% {
          transform: translate(0, 0);
        }
        10% {
          transform: translate(-5%, -5%);
        }
        20% {
          transform: translate(-10%, 5%);
        }
        30% {
          transform: translate(5%, -10%);
        }
        40% {
          transform: translate(-5%, 15%);
        }
        50% {
          transform: translate(10%, -5%);
        }
        60% {
          transform: translate(15%, 0);
        }
        70% {
          transform: translate(0, 10%);
        }
        80% {
          transform: translate(-15%, 0);
        }
        90% {
          transform: translate(10%, 5%);
        }
      }

      .paper-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 50;
        opacity: 0.4;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
        mix-blend-mode: overlay;
      }

      /* Ink Bleed Effect for Text */
      .ink-bleed {
        filter: url(#ink-bleed-filter);
      }

      /* View Transition: Fade through paper color */
      ::view-transition-old(root) {
        animation:
          0.4s cubic-bezier(0.4, 0, 0.2, 1) both fade-out,
          0.4s cubic-bezier(0.4, 0, 0.2, 1) both scale-down;
      }

      ::view-transition-new(root) {
        animation:
          0.4s cubic-bezier(0.4, 0, 0.2, 1) both fade-in,
          0.4s cubic-bezier(0.4, 0, 0.2, 1) both scale-up;
      }

      @keyframes fade-out {
        to {
          opacity: 0;
        }
      }

      @keyframes fade-in {
        from {
          opacity: 0;
        }
      }

      @keyframes scale-down {
        to {
          transform: scale(0.98);
          filter: blur(2px);
        }
      }

      @keyframes scale-up {
        from {
          transform: scale(1.02);
          filter: blur(2px);
        }
      }
    </style>
    <ClientRouter />
  </head>
  <body
    class="bg-paper text-ink antialiased min-h-screen flex flex-col items-center relative overflow-x-hidden selection:bg-ink selection:text-paper"
  >
    <!-- SVG Filters for Effects -->
    <svg style="display: none;">
      <defs>
        <filter id="ink-bleed-filter">
          <feTurbulence
            type="fractalNoise"
            baseFrequency="0.8"
            numOctaves="2"
            result="noise"></feTurbulence>
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="1.5"
          ></feDisplacementMap>
          <feGaussianBlur stdDeviation="0.4"></feGaussianBlur>
        </filter>
      </defs>
    </svg>

    <!-- Grain Overlay -->
    <div class="paper-overlay"></div>

    <div
      class="max-w-[1400px] w-full bg-paper-light min-h-screen shadow-2xl border-x border-ink-light/20 relative z-10"
    >
      <!-- Top decorative line -->
      <div class="h-1 w-full bg-ink-light/10 border-b border-ink/80"></div>

      <slot />

      <!-- Bottom decorative line -->
      <div
        class="h-4 w-full border-t-2 border-ink my-8 border-b border-ink-light/20"
      >
      </div>
    </div>
  </body>
</html>
