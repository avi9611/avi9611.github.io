---
import Layout from "../../layouts/Layout.astro";
import Navigation from "../../components/Navigation.astro";
import Footer from "../../components/Footer.astro";
import projects from "../../data/projects.json";

export async function getStaticPaths() {
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

interface Project {
  id: string;
  title: string;
  subtitle: string;
  category: "client" | "standards" | "personal";
  period: string;
  confidential?: boolean;
  description: string;
  role?: string;
  outcome?: string;
  highlights?: string[];
  stack: string[];
  tags: string[];
  github?: string;
  website?: string;
  images?: string[];
}

const { project } = Astro.props as { project: Project };
const images = project.images ?? [];

const categoryLabel = {
  client: "Client work",
  standards: "Internal standard",
  personal: "Personal work",
}[project.category];
---

<Layout
  title={`${project.title} — ${project.subtitle} | Avinash Neralakatte`}
  description={project.description}
  image={images[0] ?? "/images/avinash.jpg"}
>
  <Navigation />

  <main id="main">
    <article>
      <!-- Header -->
      <header class="shell pt-12 pb-12 md:pt-16 md:pb-14">
        <a
          href="/projects"
          class="inline-flex items-center gap-2 label hover:text-[var(--ink)] transition-colors mb-8"
        >
          <span aria-hidden="true">←</span> All work
        </a>

        <p class="label mb-4">{categoryLabel} · {project.period}</p>

        <h1 class="text-[clamp(2rem,5vw,3.25rem)] font-semibold leading-[1.1] tracking-[-0.03em] max-w-3xl">
          {project.title}
        </h1>

        <p class="lede mt-4">{project.subtitle}</p>

        {
          (project.github || project.website) && (
            <div class="mt-8 flex flex-wrap gap-3">
              {project.website && (
                <a
                  href={project.website}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn"
                >
                  Visit the site
                </a>
              )}
              {project.github && (
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-ghost"
                >
                  View the code
                </a>
              )}
            </div>
          )
        }

        {
          project.confidential && (
            <p class="mt-8 max-w-[42rem] text-[0.875rem] text-[var(--ink-soft)] border-l-2 border-[var(--rule)] pl-4 leading-relaxed">
              Built for a client of Hybrid Interactive Consultancy. The client
              name, screens and source stay private. What follows is the
              architecture and my part in it.
            </p>
          )
        }
      </header>

      <!-- Overview -->
      <section class="band section-pad">
        <div class="shell grid lg:grid-cols-[1fr_16rem] gap-12 lg:gap-16 items-start">
          <div>
            <h2 class="label mb-4">What it is</h2>
            <p class="text-[1.0625rem] leading-relaxed max-w-[42rem]">
              {project.description}
            </p>

            {
              project.highlights && (
                <>
                  <h2 class="label mt-12 mb-5">How it works</h2>
                  <ul class="space-y-4 max-w-[42rem]">
                    {project.highlights.map((h) => (
                      <li class="flex gap-3.5">
                        <span class="tick" />
                        <span class="leading-relaxed">{h}</span>
                      </li>
                    ))}
                  </ul>
                </>
              )
            }

            {
              project.outcome && (
                <>
                  <h2 class="label mt-12 mb-4">What I took from it</h2>
                  <p class="text-[1.0625rem] leading-relaxed max-w-[42rem] text-[var(--ink-mid)]">
                    {project.outcome}
                  </p>
                </>
              )
            }
          </div>

          <aside class="lg:sticky lg:top-24 space-y-8">
            {
              project.role && (
                <div>
                  <h2 class="label mb-3">My part</h2>
                  <p class="text-[0.9375rem] leading-relaxed">{project.role}</p>
                </div>
              )
            }

            <div>
              <h2 class="label mb-3">Stack</h2>
              <ul class="flex flex-wrap gap-1.5">
                {project.stack.map((s) => <li class="chip">{s}</li>)}
              </ul>
            </div>

            <div>
              <h2 class="label mb-3">Focus</h2>
              <ul class="flex flex-wrap gap-1.5">
                {project.tags.map((t) => <li class="chip">{t}</li>)}
              </ul>
            </div>
          </aside>
        </div>
      </section>

      {
        images.length > 0 && (
          <section class="band section-pad bg-[var(--surface)]">
            <div class="shell">
              <h2 class="label mb-6">Screens</h2>
              <div class="grid sm:grid-cols-2 gap-5">
                {images.map((src) => (
                  <img
                    src={src}
                    alt={`${project.title} screenshot`}
                    loading="lazy"
                    decoding="async"
                    class="w-full rounded-[5px] border border-[var(--rule)]"
                  />
                ))}
              </div>
            </div>
          </section>
        )
      }

      <section class="band">
        <div class="shell py-12 flex flex-wrap items-center justify-between gap-4">
          <a href="/projects" class="btn btn-ghost">← All work</a>
          <a href="/#contact" class="btn">Get in touch</a>
        </div>
      </section>
    </article>
  </main>

  <Footer />
</Layout>
