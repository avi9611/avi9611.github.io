---
import personal from "../data/personal.json";
import { publishedPosts } from "../lib/posts";
import { revision } from "../lib/revision";

const year = new Date().getFullYear();

// The site is dated like any other document: which revision this is, and when.
const rev = revision();
const revised = rev?.date.toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "Asia/Kolkata",
});

const hasPosts = (await publishedPosts()).length > 0;

// Internal links must not open in a new tab, so the list is split.
const links = [
  ...(hasPosts ? [{ label: "Blog", href: "/blog" }] : []),
  { label: "Activity", href: "/activity" },
];

const socials = [
  { label: "GitHub", href: personal.social.github },
  { label: "LinkedIn", href: personal.social.linkedin },
  { label: "daily.dev", href: personal.social.dailydev },
];
---

<footer class="band">
  <div class="shell py-10">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5">
      <div>
        <p class="text-[var(--ink)] font-medium">{personal.fullName}</p>
        <p class="mono !normal-case !tracking-[0.03em] text-[var(--ink-faint)] mt-1">
          {personal.role} · {personal.location}
        </p>
      </div>

      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        {
          [...links, ...socials].map((s) => (
            <li>
              <a
                href={s.href}
                target={s.href.startsWith("http") ? "_blank" : undefined}
                rel={s.href.startsWith("http") ? "noopener noreferrer" : undefined}
                class="text-[0.875rem] text-[var(--ink-soft)] hover:text-[var(--ink)] transition-colors"
              >
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mono !normal-case !tracking-[0.03em] text-[var(--ink-faint)] mt-8 pt-6 border-t border-[var(--rule-soft)] flex flex-wrap justify-between gap-x-6 gap-y-2">
      <p>
        © {year} {personal.fullName}. Built with Astro. Particle hero by{" "}
        <a
          href="https://guglielmogiannattasio.it"
          target="_blank"
          rel="noopener noreferrer"
          class="underline decoration-[var(--rule)] underline-offset-[0.2em] hover:text-[var(--ink)] hover:decoration-current"
        >
          Guglielmo Giannattasio
        </a>.
      </p>
      {
        rev && (
          <p>
            Rev {rev.number} · revised <time datetime={rev.date.toISOString()}>{revised}</time> ·{" "}
            <a
              href={`${personal.social.github}/avi9611.github.io/commits/main`}
              target="_blank"
              rel="noopener noreferrer"
              class="underline decoration-[var(--rule)] underline-offset-[0.2em] hover:text-[var(--ink)] hover:decoration-current"
            >
              change log
            </a>
          </p>
        )
      }
    </div>
  </div>
</footer>
