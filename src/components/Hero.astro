---
import personal from "../data/personal.json";
import HomeHero from "./HomeHero";
import { tenure } from "../lib/duration";

// The sculpture images ship with the hero (see README). They sit on a flat
// background, which the hero keys out by colour and repaints in the page's,
// so `background` and `darkBackground` must be real colours equal to --bg in
// global.css, not var(--bg).
const sculpture = (name: string) => `/images/sculpture/${name}.webp`;

const since = personal.currentSinceISO;
const body = personal.tagline.replace("{duration}", tenure(since, "long"));
const [first, ...rest] = personal.fullName.split(" ");
const surname = rest.join(" ");
---

<div id="home">
  <HomeHero
    client:load
    src={sculpture("wide-light")}
    darkSrc={sculpture("wide-dark")}
    mobileSrc={sculpture("tall-light")}
    mobileDarkSrc={sculpture("tall-dark")}
    imageAlt="A sculpture of pale silk ribbon and sand, looping around an empty centre"
    showNav={false}
    themeToggle={false}
    loadFonts={false}
    showCredit={false}
    eyebrow={`${personal.role} · ${personal.location}`}
    headline={`${first}\n${surname}`}
    headlineAccent={surname}
    body={body}
    bodyTemplate={personal.tagline}
    since={since}
    primaryCta={{ label: "See the work", href: "#work" }}
    secondaryCta={{ label: "Read the CV", href: personal.resume }}
    hint="Run your cursor through it"
    hintTouch="Drag a finger through it"
    background="#ebe9e5"
    darkBackground="#111110"
    textColor="var(--ink)"
    accentColor="var(--ink)"
    headingFont="var(--font-sans)"
    accentFont="var(--font-serif)"
    bodyFont="var(--font-sans)"
    height="calc(100svh - var(--nav-h))"
    sculptureScale={0.86}
    mobileSculptureScale={0.84}
    backdropText={first.toLowerCase()}
    className="home-hero"
  />
</div>
