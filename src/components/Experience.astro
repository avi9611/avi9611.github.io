---
import experience from "../data/experience.json";
import Duration from "./Duration.astro";

// The detail of each role lives in the work above it and in the CV, so this
// stays a timeline: when, where, what, and with what.
---

<section id="experience" class="band section-pad">
  <div class="shell">
    <div class="section-head">
      <h2 class="section-title">Experience</h2>
      <span class="label">{String(experience.length).padStart(2, "0")} roles</span>
    </div>

    <ol>
      {
        experience.map((job, i) => (
          <li
            class={`grid md:grid-cols-[10rem_1fr] gap-x-8 gap-y-2 py-7 ${
              i === 0 ? "pt-0" : "border-t border-[var(--rule-soft)]"
            }`}
          >
            <div class="md:pt-1">
              <p class="mono !normal-case !tracking-[0.04em] text-[var(--ink-soft)]">
                {job.period}
              </p>
              {job.current && (
                <p class="mt-2 inline-flex items-center gap-1.5 text-[0.6875rem] font-medium text-[var(--accent)]">
                  <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]" />
                  Current
                </p>
              )}
            </div>

            <div>
              <h3 class="text-[1.0625rem] font-semibold text-[var(--ink)] leading-snug">
                {job.title}
              </h3>
              <p class="text-[var(--ink-mid)] mt-0.5">
                {job.company}
                <span class="text-[var(--ink-faint)]"> · {job.location}</span>
              </p>

              <p class="mt-3 text-[var(--ink-soft)] prose-tight">
                {job.description.split("{duration}").map((part, k) => (
                  <>
                    {k > 0 && job.startISO && <Duration since={job.startISO} />}
                    {part}
                  </>
                ))}
              </p>

              <p class="mt-3 mono !normal-case !tracking-[0.03em] text-[var(--ink-faint)]">
                {job.tags.join(" · ")}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
