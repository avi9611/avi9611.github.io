---
import personal from "../data/personal.json";
---

<section
  id="home"
  class="pt-10 pb-18 px-4 md:px-8 max-w-[1400px] mx-auto border-b-4 border-double border-ink/70 relative z-10"
>
  <div
    class="flex flex-col md:flex-row justify-between gap-3 border-y border-ink/30 py-3 font-mono text-[11px] md:text-xs uppercase tracking-[0.24em] text-ink-light"
  >
    <span>Portfolio Dossier</span>
    <span class="md:text-center">FastAPI • Next.js • Docker • AI Workflows</span>
    <span>{personal.location}</span>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 mt-10 items-start">
    <div class="lg:col-span-7">
      <p class="kicker mb-4">{personal.role}</p>
      <h1 class="text-6xl md:text-8xl xl:text-[6.8rem] font-semibold leading-[0.92] text-ink-bold">
        {personal.fullName}
      </h1>
      <p class="mt-6 text-3xl md:text-4xl leading-tight font-display text-ink-bold max-w-4xl">
        {personal.headline}
      </p>
      <p class="mt-6 text-lg md:text-xl max-w-3xl text-ink/80 leading-relaxed">
        {personal.tagline}
      </p>

      <div class="mt-8 grid sm:grid-cols-2 gap-4">
        {
          personal.proofPoints.map((point) => (
            <div class="paper-card p-4">
              <p class="font-body text-base text-ink/85 leading-relaxed">{point}</p>
            </div>
          ))
        }
      </div>

      <div class="mt-8 flex flex-wrap gap-4">
        <a href="#projects" class="btn-news">View selected work</a>
        <a
          href={personal.resume}
          download
          class="btn-news btn-news-secondary"
        >
          Download resume
        </a>
      </div>
    </div>

    <div class="lg:col-span-5 space-y-6">
      <figure class="paper-card p-3">
        <img
          src={personal.profileImage}
          alt={personal.fullName}
          class="w-full aspect-[4/5] object-cover grayscale-[0.2] contrast-110 saturate-75"
          loading="eager"
        />
        <figcaption class="mt-3 font-mono text-[11px] uppercase tracking-[0.2em] text-ink-light">
          Production-minded full-stack delivery across backend, frontend, and deployment.
        </figcaption>
      </figure>

      <div class="paper-card p-6">
        <div class="flex items-center justify-between gap-4 pb-4 border-b border-ink/15">
          <div>
            <p class="kicker mb-2">Current Role</p>
            <h2 class="text-3xl font-semibold">{personal.currentCompany}</h2>
          </div>
          <span class="tag-chip">{personal.availability}</span>
        </div>

        <dl class="grid grid-cols-[110px_1fr] gap-y-3 pt-5 text-sm md:text-base">
          <dt class="font-mono uppercase tracking-[0.18em] text-ink-light">Focus</dt>
          <dd>{personal.experience}</dd>
          <dt class="font-mono uppercase tracking-[0.18em] text-ink-light">Based</dt>
          <dd>{personal.location}</dd>
          <dt class="font-mono uppercase tracking-[0.18em] text-ink-light">Primary stack</dt>
          <dd>FastAPI, Next.js, PostgreSQL, Docker, Celery, AI integrations</dd>
        </dl>
      </div>
    </div>
  </div>
</section>
