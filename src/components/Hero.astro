---
import personal from "../data/personal.json";
import Duration from "./Duration.astro";

const since = personal.currentSinceISO;
const [taglineBefore, taglineAfter] = personal.tagline.split("{duration}");
---

<section id="home" class="shell pt-16 pb-14 md:pt-24 md:pb-20">
  <p class="label mb-5">
    {personal.role} · {personal.location}
  </p>

  <h1
    class="text-[clamp(2.5rem,7vw,4.25rem)] font-semibold leading-[1.02] tracking-[-0.035em]"
  >
    {personal.fullName}
  </h1>

  <p
    class="mt-5 text-[clamp(1.25rem,2.9vw,1.75rem)] leading-[1.3] tracking-[-0.02em] text-[var(--ink)] max-w-3xl"
  >
    {personal.headline}
  </p>

  <p class="lede mt-5">
    {taglineBefore}<Duration since={since} style="long" />{taglineAfter}
  </p>

  <div class="mt-9 flex flex-wrap items-center gap-3">
    <a href="#work" class="btn">
      See the work
      <svg
        class="w-3.5 h-3.5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M5 12h14M13 6l6 6-6 6"></path>
      </svg>
    </a>
    <a href={personal.resume} download class="btn btn-ghost">Download CV</a>
  </div>

  <!-- Current role strip -->
  <dl
    class="mt-14 grid gap-x-8 gap-y-5 sm:grid-cols-2 lg:grid-cols-4 pt-8 border-t border-[var(--rule)]"
  >
    <div>
      <dt class="label mb-2">Now</dt>
      <dd class="text-[var(--ink)] font-medium leading-snug">
        {personal.currentRole}
      </dd>
      <dd class="text-[0.8125rem] text-[var(--ink-soft)] mt-0.5">
        {personal.currentCompany}
      </dd>
    </div>

    <div>
      <dt class="label mb-2">Since</dt>
      <dd class="text-[var(--ink)] font-medium">{personal.currentSince}</dd>
      <dd class="text-[0.8125rem] text-[var(--ink-soft)] mt-0.5">
        <Duration since={since} /> in production delivery
      </dd>
    </div>

    <div class="sm:col-span-2">
      <dt class="label mb-2">Primary stack</dt>
      <dd class="text-[var(--ink-mid)] leading-relaxed">
        {personal.primaryStack}
      </dd>
    </div>
  </dl>
</section>

<!-- Numbers -->
<section class="band bg-[var(--surface)]">
  <div class="shell py-10 md:py-12">
    <dl class="grid grid-cols-1 sm:grid-cols-3 gap-8 sm:gap-6">
      {
        personal.highlights.map((h) => (
          <div class="flex items-baseline gap-4 sm:block">
            <dd class="stat-value sm:mb-2">{h.value}</dd>
            <div>
              <dt class="text-[var(--ink)] font-medium text-[0.9375rem] leading-tight">
                {h.label}
              </dt>
              <dd class="text-[0.8125rem] text-[var(--ink-soft)] mt-0.5">
                {h.note.split("{duration}").map((part, i) => (
                  <>
                    {i > 0 && <Duration since={since} />}
                    {part}
                  </>
                ))}
              </dd>
            </div>
          </div>
        ))
      }
    </dl>
  </div>
</section>
