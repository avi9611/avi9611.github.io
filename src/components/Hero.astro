---
import personal from "../data/personal.json";
import Duration from "./Duration.astro";
import ActivityStrip from "./ActivityStrip.astro";

const since = personal.currentSinceISO;
const [taglineBefore, taglineAfter] = personal.tagline.split("{duration}");
---

<section id="home" class="shell pt-14 pb-16 md:pt-20 md:pb-20">
  <p class="label mb-5">
    {personal.role} · {personal.currentCompanyShort} · {personal.location}
  </p>

  <h1
    class="text-[clamp(2.5rem,7vw,4.25rem)] font-semibold leading-[1.02] tracking-[-0.035em]"
  >
    {personal.fullName}
  </h1>

  <p
    class="mt-5 text-[clamp(1.25rem,2.9vw,1.75rem)] leading-[1.3] tracking-[-0.02em] text-[var(--ink)] max-w-3xl"
  >
    {personal.headline}
  </p>

  <p class="lede mt-5">
    {taglineBefore}<Duration since={since} style="long" />{taglineAfter}
  </p>

  <div class="mt-9 flex flex-wrap items-center gap-3">
    <a href="#work" class="btn">
      See the work
      <svg
        class="w-3.5 h-3.5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M5 12h14M13 6l6 6-6 6"></path>
      </svg>
    </a>
    <a href={personal.resume} download class="btn btn-ghost">Download CV</a>
  </div>

  <!-- Proof: the numbers, then the year of work behind them. -->
  <div class="mt-14 pt-9 border-t border-[var(--rule)]">
    <dl class="grid grid-cols-3 gap-x-4 sm:gap-x-8">
      {
        personal.highlights.map((h) => (
          <div class="flex flex-col">
            <dt class="order-2 mt-2 text-[var(--ink)] font-medium text-[0.875rem] sm:text-[0.9375rem] leading-tight">
              {h.label}
            </dt>
            <dd class="order-1 stat-value">{h.value}</dd>
            <dd class="order-3 mt-1 text-[0.8125rem] text-[var(--ink-soft)] leading-snug">
              {h.note.split("{duration}").map((part, i) => (
                <>
                  {i > 0 && <Duration since={since} />}
                  {part}
                </>
              ))}
            </dd>
          </div>
        ))
      }
    </dl>

    <div class="mt-12">
      <ActivityStrip />
    </div>
  </div>
</section>
