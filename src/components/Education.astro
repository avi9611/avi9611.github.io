---
import education from "../data/education.json";
import certificates from "../data/certificates.json";

const keyCerts = [
  "Microsoft Certified: Azure Fundamentals",
  "Fundamentals of Docker & Kubernetes",
  "Learning Docker",
  "Cloud Computing Fundamentals",
  "Computer Networks & Internet Protocol",
  "Data Mining",
];

const shown = certificates.filter((c) => keyCerts.includes(c.title));
---

<section id="education" class="band section-pad">
  <div class="shell">
    <div class="section-head">
      <h2 class="section-title">Education</h2>
      <span class="label">and certifications</span>
    </div>

    <ol class="mb-12">
      {
        education.map((e, i) => (
          <li
            class={`grid md:grid-cols-[8.5rem_1fr] gap-x-8 gap-y-2 py-6 ${
              i === 0 ? "" : "border-t border-[var(--rule-soft)]"
            }`}
          >
            <p class="mono !normal-case !tracking-[0.04em] text-[var(--ink-soft)] md:pt-1">
              {e.period}
            </p>
            <div>
              <h3 class="font-semibold text-[var(--ink)]">{e.degree}</h3>
              <p class="text-[var(--ink-mid)] mt-0.5 text-[0.9375rem]">
                {e.institution}
                <span class="text-[var(--ink-faint)]"> · {e.college}</span>
              </p>
              <p class="mono !normal-case text-[var(--accent)] mt-2">{e.grade}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <h3 class="label mb-4">Selected certifications</h3>
    <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-0">
      {
        shown.map((c) => (
          <li class="py-3 border-t border-[var(--rule-soft)]">
            <a
              href={c.link}
              target="_blank"
              rel="noopener noreferrer"
              class="group block"
            >
              <p class="text-[0.9375rem] text-[var(--ink)] group-hover:text-[var(--accent)] transition-colors leading-snug">
                {c.title}
              </p>
              <p class="mono !normal-case text-[var(--ink-faint)] mt-1">
                {c.issuer}
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
