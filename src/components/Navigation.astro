---
import personal from "../data/personal.json";
import { publishedPosts } from "../lib/posts";

// The Blog link appears on its own once the first post is published.
const hasPosts = (await publishedPosts()).length > 0;

const links = [
  { href: "/#work", label: "Work" },
  { href: "/#standards", label: "Standards" },
  ...(hasPosts ? [{ href: "/blog", label: "Blog" }] : []),
  { href: "/activity", label: "Activity" },
  { href: "/#about", label: "About" },
  { href: "/#contact", label: "Contact" },
];
---

<!-- The rule under the header only appears once the page has scrolled, so at the
     top it sits on the hero the way the sculpture hero's own nav does. -->
<header
  id="site-header"
  class="no-print sticky top-0 z-40 border-b border-transparent bg-[var(--bg)]/85 backdrop-blur-md transition-colors duration-300 data-[scrolled]:border-[var(--rule)]"
>
  <nav aria-label="Main">
    <div class="shell flex items-center justify-between h-14">
      <a
        href="/"
        class="text-[1.0625rem] font-semibold tracking-[-0.02em] text-[var(--ink)] hover:opacity-65 transition-opacity"
      >
        Avinash
      </a>

      <div class="flex items-center gap-2 sm:gap-3">
        <ul class="hidden sm:flex items-center gap-1 md:gap-2">
          {
            links.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="hover-line px-2 py-1.5 text-[0.84375rem] tracking-[-0.005em] text-[var(--ink-soft)] hover:text-[var(--ink)]"
                >
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>

        <button
          id="theme-toggle"
          type="button"
          aria-label="Switch between light and dark"
          class="grid place-items-center w-[34px] h-[34px] rounded-full border border-[color-mix(in_srgb,var(--ink)_22%,transparent)] text-[var(--ink)] hover:bg-[var(--ink)] hover:text-[var(--bg)] transition-colors duration-200"
        >
          <svg
            class="w-[15px] h-[15px] hidden dark-show"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
          </svg>
          <svg
            class="w-[15px] h-[15px] light-show"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
          </svg>
        </button>

        <a
          href={personal.resume}
          download
          class="px-3.5 py-2 rounded-full border border-[color-mix(in_srgb,var(--ink)_22%,transparent)] text-[0.84375rem] text-[var(--ink)] hover:bg-[var(--ink)] hover:text-[var(--bg)] transition-colors duration-200"
        >
          CV
        </a>
      </div>
    </div>

    <!-- Phones get the same links as a second row, scrolling sideways if they run out of room. -->
    <ul class="sm:hidden shell flex items-center gap-x-4 h-10 overflow-x-auto whitespace-nowrap border-t border-[var(--rule-soft)] [scrollbar-width:none]">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="hover-line block py-2 text-[0.8125rem] text-[var(--ink-soft)] hover:text-[var(--ink)]"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  :global(html[data-theme="dark"]) .dark-show { display: block; }
  :global(html[data-theme="dark"]) .light-show { display: none; }
</style>

<script>
  function bindThemeToggle() {
    const btn = document.getElementById("theme-toggle");
    if (!btn || btn.dataset.bound === "1") return;
    btn.dataset.bound = "1";
    btn.addEventListener("click", () => {
      const root = document.documentElement;
      const next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
      root.setAttribute("data-theme", next);
      try {
        localStorage.setItem("theme", next);
      } catch {
        // Private browsing blocks writes. The toggle still works for this page.
      }
    });
  }

  bindThemeToggle();
  document.addEventListener("astro:page-load", bindThemeToggle);

  // Show the header's rule once the page has moved off the top.
  function trackScroll() {
    const header = document.getElementById("site-header");
    if (!header) return;
    header.toggleAttribute("data-scrolled", window.scrollY > 8);
  }

  window.addEventListener("scroll", trackScroll, { passive: true });
  document.addEventListener("astro:page-load", trackScroll);
</script>
