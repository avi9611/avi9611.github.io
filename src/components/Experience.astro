---
import experience from "../data/experience.json";
import Duration from "./Duration.astro";
---

<section id="experience" class="band section-pad">
  <div class="shell">
    <div class="section-head">
      <h2 class="section-title">Experience</h2>
      <span class="label">04 roles</span>
    </div>

    <ol class="space-y-0">
      {
        experience.map((job, i) => (
          <li
            class={`grid md:grid-cols-[8.5rem_1fr] gap-x-8 gap-y-3 py-8 ${
              i === 0 ? "" : "border-t border-[var(--rule-soft)]"
            }`}
          >
            <div class="md:pt-1">
              <p class="mono !normal-case !tracking-[0.04em] text-[var(--ink-soft)]">
                {job.period}
              </p>
              {job.current && (
                <p class="mt-2 inline-flex items-center gap-1.5 text-[0.6875rem] font-medium text-[var(--accent)]">
                  <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]" />
                  Current
                </p>
              )}
            </div>

            <div>
              <h3 class="text-lg font-semibold text-[var(--ink)] leading-snug">
                {job.title}
              </h3>
              <p class="text-[var(--ink-mid)] mt-0.5">
                {job.company}
                <span class="text-[var(--ink-faint)]"> · {job.location}</span>
              </p>

              <p class="mt-3 text-[var(--ink-soft)] prose-tight">
                {job.description.split("{duration}").map((part, k) => (
                  <>
                    {k > 0 && job.startISO && <Duration since={job.startISO} />}
                    {part}
                  </>
                ))}
              </p>

              <ul class="mt-4 space-y-2.5">
                {job.highlights.map((h) => (
                  <li class="flex gap-3 prose-tight">
                    <span class="tick" />
                    <span class="text-[0.9375rem] leading-relaxed">{h}</span>
                  </li>
                ))}
              </ul>

              <ul class="mt-5 flex flex-wrap gap-1.5">
                {job.tags.map((t) => (
                  <li class="chip">{t}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
