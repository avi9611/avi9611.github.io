---
import experience from '../data/experience.json';
---

<section id="experience" class="py-24 relative overflow-hidden">
  <div class="orb orb-cyan w-72 h-72 -bottom-32 -left-32 opacity-20"></div>
  
  <div class="max-w-4xl mx-auto px-6 lg:px-8 relative z-10">
    <div class="text-center mb-16">
      <h2 class="section-title">
        <span class="gradient-text">Experience</span>
      </h2>
      <p class="section-subtitle">Internships and professional journey</p>
    </div>
    
    <div class="relative">
      <!-- Timeline Line -->
      <div class="absolute left-8 top-0 bottom-0 w-px bg-gradient-to-b from-cosmic-accent via-cosmic-purple to-transparent"></div>
      
      <!-- Experience Items -->
      <div class="space-y-8">
        {experience.map((exp, index) => (
          <div class="relative pl-20 group">
            <!-- Timeline Dot -->
            <div class={`absolute left-6 top-8 w-4 h-4 rounded-full border-2 transition-all duration-300 ${exp.current ? 'bg-cosmic-accent border-cosmic-accent shadow-lg shadow-cosmic-accent/50' : 'bg-cosmic-dark border-cosmic-purple group-hover:bg-cosmic-purple'}`}>
              {exp.current && <div class="absolute inset-0 rounded-full bg-cosmic-accent animate-ping opacity-50"></div>}
            </div>
            
            <!-- Content Card -->
            <div class="glass rounded-2xl p-6 card-hover">
              <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-2 mb-4">
                <div>
                  <h3 class="text-xl font-bold text-white">{exp.title}</h3>
                  <p class="text-cosmic-accent font-medium">{exp.company}</p>
                </div>
                <div class="flex items-center gap-2">
                  {exp.current && (
                    <span class="px-3 py-1 text-xs font-medium bg-green-500/10 text-green-400 rounded-full">
                      Current
                    </span>
                  )}
                  <span class="text-cosmic-muted text-sm">{exp.period}</span>
                </div>
              </div>
              
              <p class="text-cosmic-muted leading-relaxed mb-4">{exp.description}</p>
              
              <div class="flex flex-wrap gap-2">
                {exp.tags.map((tag: string) => (
                  <span class="px-3 py-1 text-xs font-medium bg-cosmic-light rounded-full text-cosmic-text">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
