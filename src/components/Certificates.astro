---
import certificates from "../data/certificates.json";

const featuredCertificates = certificates.filter((cert) =>
  [
    "Microsoft Certified: Azure Fundamentals",
    "Learning Docker",
    "Fundamentals of Docker & Kubernetes",
    "Computer Networks & Internet Protocol",
    "Spring Boot 3, Spring 6, Hibernate & MySQL",
    "Modern React with Redux (2024)",
  ].includes(cert.title)
);
---

<section
  id="certificates"
  class="py-16 px-4 md:px-8 max-w-[1400px] mx-auto border-b-4 border-double border-ink/70"
>
  <div class="text-center mb-12">
    <h2 class="section-header inline-block">Continuous Learning</h2>
    <p class="section-lede mt-4">
      Selected certifications and coursework that complement hands-on delivery experience.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {
      featuredCertificates.map((cert) => (
        <article class="paper-card p-6 relative">
          <div class="absolute -top-3 left-5 bg-paper-light px-2 border border-ink/20 font-mono text-[11px] uppercase font-semibold tracking-[0.18em] text-ink-light">
            Certification
          </div>

          <h3 class="font-display font-semibold text-2xl mb-2 mt-2">
            {cert.title}
          </h3>
          <p class="font-mono text-[11px] uppercase text-ink-light mb-4 border-b border-ink/10 pb-3 tracking-[0.18em]">
            Issued by {cert.issuer}
          </p>

          <p class="font-body text-base leading-relaxed text-ink/80 mb-6">
            {cert.description.split(".")[0]}.
          </p>

          <div>
            <a
              href={cert.link}
              target="_blank"
              rel="noopener noreferrer"
              class="font-mono text-xs uppercase tracking-[0.18em] border-b border-ink/30 pb-1 hover:text-[var(--color-accent)] hover:border-[var(--color-accent)]"
            >
              View Credential
            </a>
          </div>
        </article>
      ))
    }
  </div>

  <p class="mt-8 text-center text-sm text-ink-light">
    Additional coursework across Git, cloud computing, backend web technologies, and data structures.
  </p>
</section>
