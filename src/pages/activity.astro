---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import ActivitySkyline from "../components/ActivitySkyline";
---

<Layout
  title="Activity — Avinash Neralakatte"
  description="A year of GitHub contributions by Avinash Neralakatte, as a heat map and a 3D skyline. Updated daily."
>
  <Navigation />

  <main id="main">
    <header class="shell pt-12 pb-10 md:pt-16 md:pb-12">
      <a href="/" class="inline-flex items-center gap-2 label hover:text-[var(--ink)] transition-colors mb-8">
        <span aria-hidden="true">←</span> Home
      </a>
      <h1 class="text-[clamp(2rem,5vw,3.25rem)] font-semibold leading-[1.1] tracking-[-0.03em]">Activity</h1>
      <p class="lede mt-4">
        Every contribution from the last year, client work included, pulled from GitHub each night.
        Switch between the heat map and the skyline, hover a day for its count, and drag the skyline to turn it.
      </p>
    </header>

    <section class="band section-pad">
      <div class="shell">
        <ActivitySkyline client:load />
      </div>
    </section>
  </main>

  <Footer />
</Layout>
