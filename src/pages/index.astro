---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Hero from "../components/Hero.astro";
import Decisions from "../components/Decisions.astro";
import Projects from "../components/Projects.astro";
import Standards from "../components/Standards.astro";
import Experience from "../components/Experience.astro";
import PersonalWork from "../components/PersonalWork.astro";
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";
import ActivityStrip from "../components/ActivityStrip.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <Navigation />
  <main id="main">
    <Hero />
    <Decisions />
    <Projects />
    <Standards />
    <Experience />
    <!-- The year of work behind it. The sculpture at the top is drawn from the same days. -->
    <section class="band py-12 md:py-16" aria-label="A year on GitHub">
      <div class="shell">
        <ActivityStrip />
        <p class="mt-5 text-[0.875rem] text-[var(--ink-soft)]">
          The gold ribbon at the top of the page is drawn from these same days. It swells in the busy weeks.
        </p>
      </div>
    </section>
    <PersonalWork />
    <About />
    <Contact />
  </main>
  <Footer />
</Layout>
