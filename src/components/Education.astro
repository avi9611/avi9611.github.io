---
import education from '../data/education.json';
---

<section id="education" class="py-24 relative overflow-hidden">
  <div class="orb orb-cyan w-80 h-80 top-0 left-1/4 opacity-20"></div>
  
  <div class="max-w-4xl mx-auto px-6 lg:px-8 relative z-10">
    <div class="text-center mb-16">
      <h2 class="section-title">
        <span class="gradient-text">Education</span>
      </h2>
      <p class="section-subtitle">Academic background and qualifications</p>
    </div>
    
    <div class="relative">
      <!-- Timeline Line -->
      <div class="absolute left-8 top-0 bottom-0 w-px bg-gradient-to-b from-cosmic-accent via-cosmic-purple to-transparent"></div>
      
      <div class="space-y-12">
        {education.map((edu) => (
          <div class="relative pl-20 group">
            <!-- Timeline Dot -->
            <div class={`absolute left-6 top-8 w-4 h-4 rounded-full border-2 transition-all duration-300 ${edu.color === 'cyan' ? 'border-cosmic-accent bg-cosmic-accent/20 group-hover:bg-cosmic-accent' : 'border-cosmic-purple bg-cosmic-purple/20 group-hover:bg-cosmic-purple'}`}></div>
            
            <!-- Content Card -->
            <div class="glass rounded-2xl p-8 card-hover">
              <span class={`text-sm font-medium ${edu.color === 'cyan' ? 'text-cosmic-accent' : 'text-cosmic-purple'}`}>
                {edu.period}
              </span>
              
              <h3 class="text-2xl font-bold text-white mt-2">{edu.degree}</h3>
              
              <p class="text-cosmic-muted mt-1">{edu.institution}</p>
              <p class="text-cosmic-muted text-sm">{edu.college}</p>
              
              <p class="text-cosmic-text mt-4 leading-relaxed">{edu.description}</p>
              
              <div class={`mt-6 inline-flex px-4 py-2 rounded-xl text-sm font-semibold ${edu.color === 'cyan' ? 'bg-cosmic-accent/10 text-cosmic-accent' : 'bg-cosmic-purple/10 text-cosmic-purple'}`}>
                {edu.grade}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
