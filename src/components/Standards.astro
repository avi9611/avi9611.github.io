---
import projects from "../data/projects.json";

const standards = projects.filter((p) => p.category === "standards");
---

<section id="standards" class="band section-pad bg-[var(--surface)]">
  <div class="shell">
    <div class="section-head">
      <h2 class="section-title">Standards I wrote</h2>
      <span class="label">Adopted internally</span>
    </div>

    <p class="lede -mt-1 mb-10">
      Client work is what I ship. These are what the team builds on. Both were
      written alongside delivery, not instead of it, and both are now the
      starting point for new projects.
    </p>

    <div class="grid md:grid-cols-2 gap-6">
      {
        standards.map((p) => (
          <article class="card p-7 flex flex-col">
            <div class="flex items-start justify-between gap-4">
              <h3 class="text-lg font-semibold text-[var(--ink)] leading-snug">
                {p.title}
              </h3>
              {p.github && (
                <a
                  href={p.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${p.title} on GitHub`}
                  class="shrink-0 text-[var(--ink-faint)] hover:text-[var(--ink)] transition-colors"
                >
                  <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2 0-.4-.5-1.6.2-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.7 1.6.2 2.8.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3" />
                  </svg>
                </a>
              )}
            </div>

            <p class="text-[var(--ink-soft)] mt-2">{p.subtitle}</p>

            <p class="mt-4 text-[0.9375rem] leading-relaxed">{p.description}</p>

            <p class="mt-4 mono !normal-case !tracking-[0.03em] text-[var(--accent)]">
              {p.role}
            </p>

            <a
              href={`/projects/${p.id}`}
              class="mt-6 pt-5 border-t border-[var(--rule-soft)] text-[0.875rem] font-medium text-[var(--ink)] hover:text-[var(--accent)] transition-colors mt-auto"
            >
              How it works →
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
