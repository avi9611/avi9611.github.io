---
import personal from "../data/personal.json";

const paragraphs = personal.bio.split("\n\n");
---

<section id="about" class="band section-pad">
  <div class="shell">
    <div class="section-head">
      <h2 class="section-title">About</h2>
      <span class="label">{personal.location}</span>
    </div>

    <div class="grid lg:grid-cols-[1fr_18rem] gap-12 lg:gap-16 items-start">
      <div>
        <div class="space-y-5 text-[1.0625rem] leading-relaxed max-w-[42rem]">
          {paragraphs.map((p) => <p>{p}</p>)}
        </div>

        <h3 class="label mt-12 mb-5">How I work</h3>
        <ul class="space-y-4 max-w-[42rem]">
          {
            personal.principles.map((p, i) => (
              <li class="flex gap-4">
                <span class="mono text-[var(--ink-faint)] pt-1 tabular-nums">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <span class="text-[var(--ink-mid)] leading-relaxed">{p}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <figure class="lg:sticky lg:top-24">
        <img
          src={personal.profileImage}
          alt={personal.fullName}
          width="288"
          height="360"
          loading="lazy"
          decoding="async"
          class="w-full aspect-[4/5] object-cover rounded-[5px] border border-[var(--rule)]"
        />
        <figcaption class="mono !normal-case !tracking-[0.03em] text-[var(--ink-faint)] mt-3 leading-relaxed">
          {personal.fullName} — {personal.currentRole} at {personal.currentCompany}.
        </figcaption>
      </figure>
    </div>
  </div>
</section>
