---
import personal from "../data/personal.json";

const navItems = [
  { href: "#home", label: "Front Page" },
  { href: "#about", label: "Editorial" },
  { href: "#experience", label: "Chronicles" },
  { href: "#skills", label: "Classifieds" },
  { href: "#projects", label: "Features" },
  { href: "#contact", label: "Letters" },
];
---

<nav
  id="navbar"
  class="sticky top-0 z-50 bg-paper border-b-2 border-b-ink border-t border-t-ink/20 py-2 w-full"
>
  <div class="max-w-6xl mx-auto px-4 flex justify-between items-center">
    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-btn"
      class="lg:hidden p-2 text-ink border border-ink"
      aria-label="Menu"
    >
      <span class="block font-display text-sm uppercase">Menu</span>
    </button>

    <!-- Desktop Navigation -->
    <div
      class="hidden lg:flex w-full justify-center items-center divide-x divide-ink/20"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="px-6 font-display font-bold uppercase tracking-widest text-sm hover:text-ink-bold hover:underline decoration-2 underline-offset-4 transition-all"
          >
            {item.label}
          </a>
        ))
      }
    </div>

    <!-- Mobile Menu Overlay -->
    <div
      id="mobile-menu"
      class="absolute top-full left-0 w-full bg-paper border-b-2 border-ink hidden flex-col border-t border-ink"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="block py-4 text-center font-display font-bold uppercase tracking-widest border-b border-ink/10 hover:bg-ink hover:text-paper transition-colors"
          >
            {item.label}
          </a>
        ))
      }
    </div>
  </div>
</nav>

<script>
  const mobileMenuBtn = document.getElementById("mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");

  mobileMenuBtn?.addEventListener("click", () => {
    mobileMenu?.classList.toggle("hidden");
  });
</script>
