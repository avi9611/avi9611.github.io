---
import Layout from "../../layouts/Layout.astro";
import Navigation from "../../components/Navigation.astro";
import Footer from "../../components/Footer.astro";
import projects from "../../data/projects.json";

export async function getStaticPaths() {
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

interface Project {
  id: string;
  title: string;
  subtitle: string;
  description: string;
  tags: string[];
  github: string;
  images: string[];
  featured: boolean;
}

const { project } = Astro.props as { project: Project };
---

<Layout
  title={`${project.title} - ${project.subtitle} | Avinash Neralakatte Portfolio`}
  description={`${project.description} Built by Avinash Neralakatte (Avinash N) using ${project.tags.slice(0, 5).join(", ")}. View project details, source code, and technical implementation.`}
  image={project.images[0]}
>
  <Navigation />

  <main class="pt-32 pb-24 min-h-screen">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      <!-- Back Link -->
      <a
        href="/projects"
        class="inline-flex items-center gap-2 text-cosmic-muted hover:text-cosmic-accent transition-colors mb-8"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Back to Projects
      </a>

      <!-- Project Header -->
      <header class="mb-12">
        <div class="flex items-start gap-4">
          {
            project.featured && (
              <span class="px-3 py-1 text-xs font-semibold bg-cosmic-accent text-cosmic-black rounded-full">
                Featured
              </span>
            )
          }
        </div>
        <h1 class="text-4xl md:text-5xl font-bold text-white mt-4 mb-3">
          {project.title}
        </h1>
        <p class="text-cosmic-accent text-xl font-medium">{project.subtitle}</p>
      </header>

      <!-- Project Images -->
      <div class="glass rounded-2xl overflow-hidden mb-12">
        <div
          class={`grid ${project.images.length > 1 ? "grid-cols-1 md:grid-cols-2" : "grid-cols-1"} gap-2`}
        >
          {
            project.images.map((img: string, index: number) => (
              <img
                src={img}
                alt={`${project.title} screenshot ${index + 1}`}
                class="w-full h-64 md:h-80 object-cover"
                loading={index === 0 ? "eager" : "lazy"}
              />
            ))
          }
        </div>
      </div>

      <!-- Project Content -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2">
          <h2 class="text-2xl font-bold text-white mb-4">About This Project</h2>
          <div class="glass rounded-2xl p-6">
            <p class="text-cosmic-text leading-relaxed">
              {project.description}
            </p>
          </div>
        </div>

        <div class="space-y-6">
          <!-- Technologies -->
          <div class="glass rounded-2xl p-6">
            <h3 class="text-lg font-semibold text-white mb-4">
              Technologies Used
            </h3>
            <div class="flex flex-wrap gap-2">
              {
                project.tags.map((tag: string) => (
                  <span class="px-3 py-1 text-sm font-medium bg-cosmic-light rounded-full text-cosmic-text">
                    {tag}
                  </span>
                ))
              }
            </div>
          </div>

          <!-- Links -->
          <div class="glass rounded-2xl p-6">
            <h3 class="text-lg font-semibold text-white mb-4">Links</h3>
            <div class="space-y-3">
              <a
                href={project.github}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-3 text-cosmic-muted hover:text-cosmic-accent transition-colors"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path
                    d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
                  ></path>
                </svg>
                View on GitHub
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Other Projects -->
      <div class="mt-16">
        <h2 class="text-2xl font-bold text-white mb-6">Other Projects</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {
            projects
              .filter((p: Project) => p.id !== project.id)
              .slice(0, 2)
              .map((p: Project) => (
                <a
                  href={`/projects/${p.id}`}
                  class="glass rounded-xl p-4 card-hover flex gap-4 items-center"
                >
                  <img
                    src={p.images[0]}
                    alt={p.title}
                    class="w-20 h-20 rounded-lg object-cover flex-shrink-0"
                    loading="lazy"
                  />
                  <div>
                    <h3 class="font-semibold text-white line-clamp-1">
                      {p.title}
                    </h3>
                    <p class="text-cosmic-muted text-sm line-clamp-2">
                      {p.subtitle}
                    </p>
                  </div>
                </a>
              ))
          }
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
