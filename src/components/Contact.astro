---
import personal from "../data/personal.json";

const channels = [
  { label: "Email", value: personal.email, href: `mailto:${personal.email}` },
  { label: "Phone", value: personal.phone, href: `tel:${personal.phone.replace(/\s/g, "")}` },
  { label: "LinkedIn", value: "avinash-n-dev", href: personal.social.linkedin },
  { label: "GitHub", value: "avi9611", href: personal.social.github },
];
---

<section id="contact" class="band section-pad bg-[var(--surface)]">
  <div class="shell">
    <div class="section-head">
      <h2 class="section-title">Contact</h2>
      <span class="label">{personal.availability}</span>
    </div>

    <div class="grid lg:grid-cols-[1fr_1fr] gap-12 lg:gap-20 items-start">
      <div>
        <p class="text-[1.125rem] leading-relaxed text-[var(--ink-mid)] max-w-[36rem]">
          I am based in {personal.location} and open to conversations about
          backend architecture, product delivery, and roles where the system
          has to keep working after I hand it over.
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href={`mailto:${personal.email}`} class="btn">Send an email</a>
          <a href={personal.resume} download class="btn btn-ghost">Download CV</a>
        </div>
      </div>

      <dl>
        {
          channels.map((c) => (
            <div class="flex items-baseline justify-between gap-6 py-3.5 border-t border-[var(--rule)]">
              <dt class="label">{c.label}</dt>
              <dd class="text-right">
                <a
                  href={c.href}
                  target={c.href.startsWith("http") ? "_blank" : undefined}
                  rel={c.href.startsWith("http") ? "noopener noreferrer" : undefined}
                  class="link-underline text-[0.9375rem]"
                >
                  {c.value}
                </a>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
