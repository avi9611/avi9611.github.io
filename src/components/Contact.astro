---
import personal from "../data/personal.json";
---

<section
  id="contact"
  class="py-16 px-4 md:px-8 max-w-[1400px] mx-auto bg-paper"
>
  <div
    class="border-4 border-double border-ink p-8 md:p-12 text-center max-w-4xl mx-auto"
  >
    <h2 class="font-display font-black text-4xl md:text-5xl uppercase mb-4">
      Inquire Within
    </h2>
    <p class="font-serif italic text-xl text-ink/70 mb-8">
      Open for commissions, employment, and technical correspondence.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
      <a
        href={`mailto:${personal.email}`}
        class="group border border-ink p-6 hover:bg-ink hover:text-paper transition-colors"
      >
        <h3 class="font-bold uppercase font-mono text-lg mb-2">
          Electronic Mail
        </h3>
        <p class="text-sm break-all">{personal.email}</p>
      </a>
      <a
        href={`tel:${personal.phone}`}
        class="group border border-ink p-6 hover:bg-ink hover:text-paper transition-colors"
      >
        <h3 class="font-bold uppercase font-mono text-lg mb-2">Telephone</h3>
        <p class="text-sm">{personal.phone}</p>
      </a>
      <div
        class="group border border-ink p-6 hover:bg-ink hover:text-paper transition-colors cursor-default"
      >
        <h3 class="font-bold uppercase font-mono text-lg mb-2">Office</h3>
        <p class="text-sm">{personal.location}</p>
      </div>
    </div>

    <div class="border-t-2 border-dashed border-ink pt-8">
      <h3 class="font-display font-bold uppercase text-xl mb-6">
        Or Send a Wire
      </h3>
      <div class="flex flex-wrap justify-center gap-4">
        <a href={personal.social.github} target="_blank" class="btn-news px-8"
          >Github</a
        >
        <a href={personal.social.linkedin} target="_blank" class="btn-news px-8"
          >LinkedIn</a
        >
        <a href={personal.social.leetcode} target="_blank" class="btn-news px-8"
          >LeetCode</a
        >
      </div>
    </div>
  </div>
</section>
