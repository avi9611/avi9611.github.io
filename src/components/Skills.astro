---
import skills from "../data/skills.json";
---

<section id="skills" class="band section-pad bg-[var(--surface)]">
  <div class="shell">
    <div class="section-head">
      <h2 class="section-title">Capabilities</h2>
      <span class="label">{skills.categories.length} areas</span>
    </div>

    <div class="grid md:grid-cols-2 gap-x-12 gap-y-10">
      {
        skills.categories.map((cat) => (
          <div>
            <h3 class="text-[1.0625rem] font-semibold text-[var(--ink)]">
              {cat.title}
            </h3>
            <p class="text-[0.9375rem] text-[var(--ink-soft)] mt-2 leading-relaxed">
              {cat.summary}
            </p>
            <ul class="mt-4 flex flex-wrap gap-1.5">
              {cat.skills.map((s) => (
                <li class="chip !bg-[var(--bg)]">{s}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
