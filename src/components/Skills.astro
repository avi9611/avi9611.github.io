---
import skillsData from "../data/skills.json";
---

<section
  id="skills"
  class="py-16 border-b-4 border-double border-ink bg-paper px-4 md:px-8 max-w-[1400px] mx-auto"
>
  <div class="border-b-2 border-ink mb-8 text-center md:text-left">
    <h2
      class="font-display font-black text-4xl uppercase tracking-tighter mb-2"
    >
      Market Skills & Tech
    </h2>
    <div
      class="font-mono text-xs uppercase flex flex-col md:flex-row justify-between py-1 border-t border-ink/20"
    >
      <span>Current Valuations</span>
      <span>High Demand Sectors</span>
    </div>
  </div>

  <div class="columns-1 md:columns-2 lg:columns-4 gap-6 space-y-6">
    {
      skillsData.categories.map((category, index) => (
        <div class="break-inside-avoid border border-ink p-4 bg-white/5 relative">
          <div class="absolute -top-3 left-4 bg-paper px-2 font-mono text-xs font-bold uppercase border border-ink text-ink-light">
            SEC. {index + 1}00
          </div>
          <h3 class="font-display font-bold uppercase text-lg mb-4 border-b-2 border-ink pb-1 mt-2">
            {category.title}
          </h3>
          <ul class="space-y-2">
            {category.skills.map((skill: { name: string; icon: string }) => (
              <li class="flex items-center gap-3 font-mono text-xs uppercase tracking-wide group hover:bg-ink hover:text-paper cursor-default transition-colors p-1 border-b border-dotted border-ink/20 last:border-0">
                <div class="w-5 h-5 flex items-center justify-center bg-white border border-ink/20 p-0.5 rounded-sm">
                  <img
                    src={skill.icon}
                    alt={skill.name}
                    class="w-full h-full object-contain grayscale group-hover:grayscale-0 transition-all duration-300"
                    loading="lazy"
                  />
                </div>
                <span>{skill.name}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div
    class="mt-8 border-t border-ink pt-4 text-center font-mono text-xs italic text-ink/60"
  >
    * Skills are subject to rapid appreciation.
  </div>
</section>
