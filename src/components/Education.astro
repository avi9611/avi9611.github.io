---
import education from "../data/education.json";
---

<section
  id="education"
  class="py-16 px-4 md:px-8 max-w-[1400px] mx-auto bg-paper border-b-4 border-double border-ink"
>
  <div class="text-center mb-12">
    <h2 class="section-header inline-block">Background Check</h2>
  </div>

  <div class="space-y-8 max-w-4xl mx-auto">
    {
      education.map((edu) => (
        <div class="border border-ink p-6 bg-paper-light relative">
          <div class="absolute -top-3 right-4 bg-paper px-2 border border-ink font-mono text-xs uppercase font-bold text-ink-light">
            Verified Record
          </div>

          <div class="flex flex-col md:flex-row md:items-baseline justify-between gap-4 mb-4 border-b border-ink/10 pb-4">
            <h3 class="font-display font-bold text-2xl uppercase">
              {edu.degree}
            </h3>
            <span class="font-mono text-sm font-bold uppercase tracking-widest">
              {edu.period}
            </span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <h4 class="font-bold text-lg">{edu.institution}</h4>
              <p class="text-ink-light italic">{edu.college}</p>
            </div>
            <div class="text-right flex flex-col items-start md:items-end justify-center">
              <div class="font-mono text-xs uppercase mb-1">
                Performance Index
              </div>
              <div class="text-xl font-bold font-display border border-ink px-3 py-1 bg-white text-black">
                {edu.grade}
              </div>
            </div>
          </div>

          <p class="mt-4 text-justify font-body text-sm leading-relaxed text-ink/80">
            {edu.description}
          </p>
        </div>
      ))
    }
  </div>
</section>
