---
import personal from "../data/personal.json";
---

<section
  id="home"
  class="pt-12 pb-16 px-4 md:px-8 max-w-[1400px] mx-auto border-b-4 border-double border-ink relative bg-paper z-10"
>
  <!-- Masthead -->
  <header class="text-center mb-12 relative">
    <div class="border-b-4 border-ink pb-2 mb-2">
      <h1
        class="font-display text-6xl md:text-8xl lg:text-9xl font-black uppercase tracking-tighter leading-none"
      >
        {personal.name}
      </h1>
    </div>

    <div
      class="flex flex-col md:flex-row justify-between items-center border-b-2 border-ink py-2 font-mono text-xs md:text-sm uppercase tracking-widest text-ink/80 px-2 gap-2"
    >
      <span>Vol. I, Issue No. 1</span>
      <span
        class="flex-1 text-center hidden md:block border-x border-ink/20 mx-4"
        >Bangalore Edition • {
          new Date().toLocaleDateString("en-US", {
            weekday: "long",
            year: "numeric",
            month: "long",
            day: "numeric",
          })
        }</span
      >
      <span>Price: Free</span>
    </div>
  </header>

  <!-- Headline Feature -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
    <!-- Main Feature Column -->
    <div class="lg:col-span-8 lg:border-r border-ink/20 lg:pr-8">
      <div class="mb-6">
        <h2
          class="font-display text-4xl md:text-6xl font-bold leading-none uppercase mb-2"
        >
          Full Stack Developer <br />
          <span
            class="italic font-serif font-normal normal-case text-3xl md:text-4xl text-ink/80"
            >Ready to build the next big thing</span
          >
        </h2>
        <div class="h-1 w-24 bg-ink mb-1"></div>
      </div>

      <div class="flex flex-col md:flex-row gap-8 mb-8">
        <figure class="flex-shrink-0 md:w-1/2">
          <div class="border border-ink p-1 bg-white inline-block w-full">
            <img
              src={personal.profileImage}
              alt={personal.name}
              class="w-full h-auto grayscale contrast-125 block filter sepia-[.2]"
              loading="eager"
            />
          </div>
          <figcaption
            class="font-mono text-xs mt-2 text-ink/60 border-l-2 border-ink/30 pl-2"
          >
            FIG 1.0: {personal.name}, spotted in the wild coding environment.
          </figcaption>
        </figure>

        <div class="md:w-1/2 flex flex-col justify-between">
          <article class="font-body text-lg leading-relaxed text-justify mb-6">
            <span
              class="float-left text-5xl font-display font-black leading-[0.8] mr-2 mt-1"
              >H</span
            >
            <span class="font-bold uppercase tracking-wide text-sm mr-1"
              >ELLO WORLD.</span
            >
            {personal.tagline}
            <br /><br />
            {personal.role} based in {personal.location}, specializing in the
            MERN stack and cloud technologies. Currently focusing on building
            scalable web applications and exploring new architectural patterns.
          </article>

          <div class="border-t border-b border-ink py-4 my-2">
            <p
              class="font-display font-bold text-xl uppercase mb-2 text-center"
            >
              In This Edition
            </p>
            <div class="grid grid-cols-2 gap-4 text-sm font-mono">
              <a href="#projects" class="hover:underline">>> TOP PROJECTS</a>
              <a href="#skills" class="hover:underline text-right"
                >SKILLS REPORT <<</a
              >
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Side Column (Sidebar) -->
    <div class="lg:col-span-4 flex flex-col gap-8">
      <!-- Status Box -->
      <div class="border border-ink p-4 bg-paper-light">
        <h3
          class="font-display font-bold uppercase text-xl mb-1 border-b-2 border-ink inline-block"
        >
          Market Status
        </h3>
        <div class="mt-4 flex items-center gap-3">
          <div class="relative w-4 h-4">
            <span
              class="absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75 animate-ping"
            ></span>
            <span class="relative inline-flex rounded-full h-4 w-4 bg-green-500"
            ></span>
          </div>
          <span class="font-mono text-sm font-bold uppercase tracking-wider"
            >{personal.availability}</span
          >
        </div>
        <p class="font-body text-sm mt-2 italic text-ink/70">
          "Open to discussing new opportunities and collaborations."
        </p>
      </div>

      <!-- Wire Services / Socials -->
      <div>
        <h3
          class="font-display font-bold uppercase text-lg mb-2 border-b border-ink/50 block"
        >
          Wire Services
        </h3>
        <ul class="flex flex-col gap-2">
          <li>
            <a
              href={personal.social.github}
              target="_blank"
              class="flex items-center justify-between group hover:bg-ink hover:text-paper p-2 transition-colors border-b border-dotted border-ink/30 cursor-pointer"
            >
              <span class="font-mono text-sm font-bold">GITHUB</span>
              <span
                class="text-xs group-hover:translate-x-1 transition-transform"
                >-></span
              >
            </a>
          </li>
          <li>
            <a
              href={personal.social.linkedin}
              target="_blank"
              class="flex items-center justify-between group hover:bg-ink hover:text-paper p-2 transition-colors border-b border-dotted border-ink/30 cursor-pointer"
            >
              <span class="font-mono text-sm font-bold">LINKEDIN</span>
              <span
                class="text-xs group-hover:translate-x-1 transition-transform"
                >-></span
              >
            </a>
          </li>
          <li>
            <a
              href={personal.social.leetcode}
              target="_blank"
              class="flex items-center justify-between group hover:bg-ink hover:text-paper p-2 transition-colors border-b border-dotted border-ink/30 cursor-pointer"
            >
              <span class="font-mono text-sm font-bold">LEETCODE</span>
              <span
                class="text-xs group-hover:translate-x-1 transition-transform"
                >-></span
              >
            </a>
          </li>
        </ul>
      </div>

      <!-- Ad / CTA -->
      <div
        class="border-4 border-double border-ink p-6 text-center mt-auto hover:bg-ink hover:text-paper transition-colors group cursor-pointer relative overflow-hidden"
      >
        <a href={personal.resume} download class="absolute inset-0 z-10"></a>
        <p
          class="font-display font-black text-2xl uppercase leading-none mb-1 group-hover:text-paper"
        >
          Extra! Extra!
        </p>
        <p class="font-serif italic text-lg mb-4 group-hover:text-paper">
          Read all about it
        </p>
        <div
          class="inline-block border border-ink px-4 py-1 font-mono text-xs uppercase bg-white text-black font-bold group-hover:bg-paper group-hover:text-white border-none"
        >
          Download Resume
        </div>
      </div>
    </div>
  </div>
</section>
