---
import personal from "../data/personal.json";

const currentYear = new Date().getFullYear();
---

<footer class="py-12 bg-paper text-ink border-t-8 border-ink">
  <div class="max-w-4xl mx-auto px-6 text-center">
    <div class="mb-8">
      <h2
        class="font-display font-black text-3xl uppercase tracking-widest mb-2"
      >
        {personal.name}
      </h2>
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-ink-light">
        Established {currentYear}
      </p>
    </div>

    <div
      class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12 font-mono text-sm border-t border-b border-ink/20 py-8"
    >
      <div>
        <h4 class="font-bold uppercase mb-2">Navigation</h4>
        <nav class="flex flex-col gap-2">
          <a href="#home" class="hover:underline">Front Page</a>
          <a href="#about" class="hover:underline">Editorial</a>
          <a href="#projects" class="hover:underline">Features</a>
        </nav>
      </div>
      <div>
        <h4 class="font-bold uppercase mb-2">Connect</h4>
        <nav class="flex flex-col gap-2">
          <a
            href={personal.social.github}
            target="_blank"
            class="hover:underline">Github</a
          >
          <a
            href={personal.social.linkedin}
            target="_blank"
            class="hover:underline">LinkedIn</a
          >
          <a href={`mailto:${personal.email}`} class="hover:underline">Email</a>
        </nav>
      </div>
      <div>
        <h4 class="font-bold uppercase mb-2">Legals</h4>
        <p class="text-ink-light">
          © {currentYear}
          {personal.name}.<br />All rights reserved.
        </p>
      </div>
    </div>

    <p class="font-serif italic text-ink/50 text-sm">
      Built with Astro, Tailwind, and a lot of coffee. Printed in the Digital
      Ether.
    </p>
  </div>
</footer>
