---
import education from "../data/education.json";
---

<section
  id="education"
  class="py-16 px-4 md:px-8 max-w-[1400px] mx-auto border-b-4 border-double border-ink/70"
>
  <div class="text-center mb-12">
    <h2 class="section-header inline-block">Education</h2>
    <p class="section-lede mt-4">
      Formal foundations that support the practical engineering work above.
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    {
      education.map((edu) => (
        <article class="paper-card p-6 md:p-7 relative">
          <div class="absolute -top-3 right-4 bg-paper-light px-2 border border-ink/20 font-mono text-[11px] uppercase font-semibold text-ink-light tracking-[0.18em]">
            Academic foundation
          </div>

          <div class="flex flex-col md:flex-row md:items-baseline justify-between gap-4 mb-4 border-b border-ink/10 pb-4">
            <h3 class="font-display font-semibold text-3xl">
              {edu.degree}
            </h3>
            <span class="font-mono text-xs font-semibold uppercase tracking-[0.2em] text-ink-light">
              {edu.period}
            </span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <h4 class="font-semibold text-lg text-ink-bold">{edu.institution}</h4>
              <p class="text-ink-light">{edu.college}</p>
            </div>
            <div class="text-right flex flex-col items-start md:items-end justify-center">
              <div class="font-mono text-[11px] uppercase tracking-[0.18em] mb-1 text-ink-light">
                Result
              </div>
              <div class="text-xl font-semibold font-display border border-ink/20 px-3 py-1 bg-white/60 text-ink-bold">
                {edu.grade}
              </div>
            </div>
          </div>

          <p class="mt-4 font-body text-base leading-relaxed text-ink/80">
            {edu.description}
          </p>
        </article>
      ))
    }
  </div>
</section>
