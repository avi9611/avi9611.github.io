---
import personal from '../data/personal.json';

const currentYear = new Date().getFullYear();
---

<footer class="py-12 border-t border-white/5">
  <div class="max-w-6xl mx-auto px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <!-- Logo & Copyright -->
      <div class="flex items-center gap-4">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-cosmic-accent to-cosmic-purple flex items-center justify-center text-white font-bold">
          AN
        </div>
        <div>
          <p class="text-white font-semibold">{personal.name}</p>
          <p class="text-cosmic-muted text-sm">© {currentYear} All rights reserved.</p>
        </div>
      </div>
      
      <!-- Quick Links -->
      <div class="flex gap-6 text-sm">
        <a href="#home" class="text-cosmic-muted hover:text-cosmic-accent transition-colors">Home</a>
        <a href="#about" class="text-cosmic-muted hover:text-cosmic-accent transition-colors">About</a>
        <a href="#projects" class="text-cosmic-muted hover:text-cosmic-accent transition-colors">Projects</a>
        <a href="/blog" class="text-cosmic-muted hover:text-cosmic-accent transition-colors">Blog</a>
        <a href="#contact" class="text-cosmic-muted hover:text-cosmic-accent transition-colors">Contact</a>
      </div>
      
      <!-- Made with -->
      <p class="text-cosmic-muted text-sm flex items-center gap-2">
        Built with
        <svg class="w-4 h-4 text-red-500" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
        </svg>
        using
        <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="text-cosmic-accent hover:text-cosmic-purple transition-colors font-medium">
          Astro
        </a>
      </p>
    </div>
  </div>
</footer>
