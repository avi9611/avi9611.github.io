---
import "../styles/global.css";
import personal from "../data/personal.json";
import { ClientRouter } from "astro:transitions";
import { tenure } from "../lib/duration";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Avinash Neralakatte — Full-Stack Engineer | FastAPI, Next.js, PostgreSQL",
  description = "Avinash Neralakatte is a full-stack engineer in Kochi building production CRM and ERP systems on FastAPI and Next.js. Eight client products shipped in nine months, plus the internal frontend template and backend conventions his team builds on.",
  image = "/images/avinash.jpg",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const sameAs = Object.values(personal.social).filter(Boolean);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Avinash Neralakatte",
  alternateName: ["Avinash N", "Avinash Poojary"],
  jobTitle: personal.role,
  description: personal.tagline.replace(
    "{duration}",
    tenure(personal.currentSinceISO, "long")
  ),
  url: Astro.site?.toString() || "https://avi9611.github.io",
  image: `${Astro.site}images/avinash.jpg`,
  sameAs,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Kochi",
    addressRegion: "Kerala",
    addressCountry: "IN",
  },
  email: personal.email,
  knowsAbout: [
    "FastAPI", "Next.js", "React", "Python", "TypeScript", "PostgreSQL",
    "Redis", "Celery", "Docker", "SQLAlchemy", "Modular monolith architecture",
    "Role-based access control", "Multi-tenancy", "Audit logging",
    "REST API design", "LLM integration", "Full-stack development",
  ],
  alumniOf: {
    "@type": "EducationalOrganization",
    name: "Visvesvaraya Technological University",
  },
  worksFor: {
    "@type": "Organization",
    name: "Hybrid Interactive Consultancy LLP",
  },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: Astro.site?.toString() || "https://avi9611.github.io",
    },
    ...(Astro.url.pathname !== "/"
      ? [{
          "@type": "ListItem",
          position: 2,
          name: title.split("|")[0].split("—")[0].trim(),
          item: canonicalURL.toString(),
        }]
      : []),
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={personal.fullName} />
    <meta
      name="keywords"
      content="Avinash Neralakatte, Avinash N, full-stack engineer, FastAPI, Next.js, React, PostgreSQL, Redis, Celery, Docker, Python, TypeScript, modular monolith, RBAC, multi-tenancy, audit logging, CRM, ERP, Kochi developer, India, portfolio"
    />

    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/jpeg" href="/images/avinash.jpg" />
    <link rel="apple-touch-icon" href="/images/avinash.jpg" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${Astro.site}${image.replace(/^\//, "")}`} />
    <meta property="og:site_name" content={`${personal.fullName} — Portfolio`} />
    <meta property="og:locale" content="en_US" />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={`${Astro.site}${image.replace(/^\//, "")}`} />

    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#fcfcfb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0e10" media="(prefers-color-scheme: dark)" />
    <meta name="geo.region" content="IN-KL" />
    <meta name="geo.placename" content="Kochi" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

    <!-- Set theme before first paint so there is no flash. -->
    <script is:inline>
      (function () {
        function apply() {
          var saved = null;
          try { saved = localStorage.getItem("theme"); } catch (e) {}
          var prefersDark =
            window.matchMedia &&
            window.matchMedia("(prefers-color-scheme: dark)").matches;
          var theme = saved || (prefersDark ? "dark" : "light");
          document.documentElement.setAttribute("data-theme", theme);
        }
        apply();
        document.addEventListener("astro:after-swap", apply);
      })();
    </script>

    <style is:global>
      ::view-transition-old(root) { animation: 0.22s ease both vt-out; }
      ::view-transition-new(root) { animation: 0.22s ease both vt-in; }
      @keyframes vt-out { to { opacity: 0; } }
      @keyframes vt-in { from { opacity: 0; } }

      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(root),
        ::view-transition-new(root) { animation: none; }
      }
    </style>

    <!-- Keep tenure correct between deploys. The build writes today's value;
         this re-checks it in the visitor's browser. -->
    <script>
      import { tenure } from "../lib/duration";

      function refreshDurations() {
        document
          .querySelectorAll("[data-duration][data-since]")
          .forEach((el) => {
            const since = el.getAttribute("data-since");
            const style =
              el.getAttribute("data-duration") === "long" ? "long" : "short";
            if (!since) return;
            el.textContent = tenure(since, style);
          });
      }

      refreshDurations();
      document.addEventListener("astro:page-load", refreshDurations);
    </script>

    <ClientRouter />
  </head>

  <body>
    <a
      href="#main"
      class="no-print sr-only focus:not-sr-only focus:absolute focus:z-50 focus:top-3 focus:left-3 focus:px-3 focus:py-2 focus:bg-[var(--ink)] focus:text-[var(--bg)] focus:rounded"
    >
      Skip to content
    </a>
    <slot />
  </body>
</html>
