---
import projects from "../data/projects.json";

const client = projects.filter((p) => p.category === "client");
---

<section id="work" class="band section-pad">
  <div class="shell">
    <div class="section-head">
      <h2 class="section-title">Client work</h2>
      <span class="label">{String(client.length).padStart(2, "0")} products</span>
    </div>

    <p class="lede -mt-1 mb-9">
      Line-of-business systems companies run their operations on. These were
      built for clients of Hybrid Interactive, so names and screens stay out of
      it. The architecture does not.
    </p>

    <ul>
      {
        client.map((p) => (
          <li>
            <a href={`/projects/${p.id}`} class="row-link group">
              <div class="grid md:grid-cols-[1fr_auto] gap-x-8 gap-y-2 items-start">
                <div>
                  <h3 class="row-title text-lg font-semibold text-[var(--ink)] leading-snug">
                    {p.title}
                    <span class="arrow ml-1.5">→</span>
                  </h3>
                  <p class="text-[var(--ink-soft)] mt-1 prose-tight">
                    {p.subtitle}
                  </p>
                  <ul class="mt-3.5 flex flex-wrap gap-1.5">
                    {p.stack.slice(0, 6).map((s) => (
                      <li class="chip">{s}</li>
                    ))}
                    {p.stack.length > 6 && (
                      <li class="chip !bg-transparent !border-transparent">
                        +{p.stack.length - 6}
                      </li>
                    )}
                  </ul>
                </div>

                <div class="md:text-right shrink-0 md:pt-1">
                  <p class="mono !normal-case !tracking-[0.04em] text-[var(--ink-faint)]">
                    {p.period}
                  </p>
                  {p.confidential && (
                    <p class="mono !text-[0.625rem] text-[var(--ink-faint)] mt-1.5">
                      Client work
                    </p>
                  )}
                </div>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
