---
import Layout from "../../layouts/Layout.astro";
import Navigation from "../../components/Navigation.astro";
import Footer from "../../components/Footer.astro";
import projects from "../../data/projects.json";

const groups = [
  {
    key: "client",
    title: "Client work",
    note: "Line-of-business systems built at Hybrid Interactive. Names and screens stay private.",
  },
  {
    key: "standards",
    title: "Standards",
    note: "The internal template and conventions kit our new projects start from.",
  },
  {
    key: "personal",
    title: "Personal work",
    note: "Things I built on my own, live products and open source.",
  },
];
---

<Layout
  title="Work — Avinash Neralakatte"
  description="Production CRM, ERP and hospital systems, internal engineering standards, and personal projects by Avinash Neralakatte, full-stack engineer in Kochi."
>
  <Navigation />

  <main id="main">
    <header class="shell pt-12 pb-10 md:pt-16 md:pb-12">
      <a
        href="/"
        class="inline-flex items-center gap-2 label hover:text-[var(--ink)] transition-colors mb-8"
      >
        <span aria-hidden="true">←</span> Home
      </a>
      <h1 class="text-[clamp(2rem,5vw,3.25rem)] font-semibold leading-[1.1] tracking-[-0.03em]">
        Work
      </h1>
      <p class="lede mt-4">
        {projects.length} entries. The client systems are where most of the
        engineering happened. The standards are what came out of it.
      </p>
    </header>

    {
      groups.map((g) => {
        const items = projects.filter((p) => p.category === g.key);
        return (
          <section class="band section-pad">
            <div class="shell">
              <div class="section-head">
                <h2 class="section-title">{g.title}</h2>
                <span class="label">
                  {String(items.length).padStart(2, "0")}
                </span>
              </div>
              <p class="lede -mt-1 mb-8">{g.note}</p>

              <ul>
                {items.map((p) => (
                  <li>
                    <a href={`/projects/${p.id}`} class="row-link group">
                      <div class="grid md:grid-cols-[1fr_auto] gap-x-8 gap-y-2 items-start">
                        <div>
                          <h3 class="row-title text-lg font-semibold text-[var(--ink)] leading-snug">
                            {p.title}
                            <span class="arrow ml-1.5">→</span>
                          </h3>
                          <p class="text-[var(--ink-soft)] mt-1 prose-tight">
                            {p.subtitle}
                          </p>
                          <ul class="mt-3.5 flex flex-wrap gap-1.5">
                            {p.stack.slice(0, 6).map((s) => (
                              <li class="chip">{s}</li>
                            ))}
                            {p.stack.length > 6 && (
                              <li class="chip !bg-transparent !border-transparent">
                                +{p.stack.length - 6}
                              </li>
                            )}
                          </ul>
                        </div>
                        <p class="mono !normal-case !tracking-[0.04em] text-[var(--ink-faint)] shrink-0 md:pt-1 md:text-right">
                          {p.period}
                        </p>
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        );
      })
    }
  </main>

  <Footer />
</Layout>
