---
import personal from '../data/personal.json';
---

<section id="contact" class="py-24 relative overflow-hidden">
  <div class="orb orb-purple w-96 h-96 top-0 left-1/2 -translate-x-1/2 opacity-20"></div>
  <div class="orb orb-coral w-64 h-64 bottom-0 right-0 opacity-20"></div>
  
  <div class="max-w-4xl mx-auto px-6 lg:px-8 relative z-10">
    <div class="text-center mb-16">
      <h2 class="section-title">
        <span class="gradient-text">Get In Touch</span>
      </h2>
      <p class="section-subtitle">
        Let's discuss how I can contribute to your team or project. Feel free to reach out via email, phone, or connect with me on social media.
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
      <!-- Email Card -->
      <a 
        href={`mailto:${personal.email}`}
        class="glass rounded-2xl p-8 text-center card-hover group"
      >
        <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-cosmic-accent/10 flex items-center justify-center group-hover:bg-cosmic-accent/20 transition-colors">
          <svg class="w-7 h-7 text-cosmic-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-white mb-2">Email</h3>
        <p class="text-cosmic-muted text-sm break-all">{personal.email}</p>
      </a>
      
      <!-- Phone Card -->
      <a 
        href={`tel:${personal.phone}`}
        class="glass rounded-2xl p-8 text-center card-hover group"
      >
        <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-cosmic-purple/10 flex items-center justify-center group-hover:bg-cosmic-purple/20 transition-colors">
          <svg class="w-7 h-7 text-cosmic-purple" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-white mb-2">Phone</h3>
        <p class="text-cosmic-muted text-sm">{personal.phone}</p>
      </a>
      
      <!-- Location Card -->
      <div class="glass rounded-2xl p-8 text-center card-hover group">
        <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-cosmic-coral/10 flex items-center justify-center group-hover:bg-cosmic-coral/20 transition-colors">
          <svg class="w-7 h-7 text-cosmic-coral" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-white mb-2">Location</h3>
        <p class="text-cosmic-muted text-sm">{personal.location}</p>
      </div>
    </div>
    
    <!-- Social Links -->
    <div class="glass rounded-2xl p-8">
      <h3 class="text-center text-lg font-semibold text-white mb-6">Connect With Me</h3>
      <div class="flex flex-wrap gap-4 justify-center">
        <a 
          href={personal.social.github}
          target="_blank"
          rel="noopener noreferrer"
          class="w-14 h-14 glass-light rounded-xl flex items-center justify-center hover:bg-white/10 transition-all duration-200 group"
          aria-label="GitHub"
        >
          <svg class="w-6 h-6 text-cosmic-muted group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
        </a>
        <a 
          href={personal.social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="w-14 h-14 glass-light rounded-xl flex items-center justify-center hover:bg-white/10 transition-all duration-200 group"
          aria-label="LinkedIn"
        >
          <svg class="w-6 h-6 text-cosmic-muted group-hover:text-[#0077B5] transition-colors" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
        <a 
          href={personal.social.leetcode}
          target="_blank"
          rel="noopener noreferrer"
          class="w-14 h-14 glass-light rounded-xl flex items-center justify-center hover:bg-white/10 transition-all duration-200 group"
          aria-label="LeetCode"
        >
          <svg class="w-6 h-6 text-cosmic-muted group-hover:text-[#FFA116] transition-colors" fill="currentColor" viewBox="0 0 24 24">
            <path d="M16.102 17.93l-2.697 2.607c-.466.467-1.111.662-1.823.662s-1.357-.195-1.824-.662l-4.332-4.363c-.467-.467-.702-1.15-.702-1.863s.235-1.357.702-1.824l4.319-4.38c.467-.467 1.125-.645 1.837-.645s1.357.195 1.823.662l2.697 2.606c.514.515 1.365.497 1.9-.038.535-.536.553-1.387.039-1.901l-2.609-2.636a5.055 5.055 0 0 0-2.445-1.337l2.467-2.503c.516-.514.498-1.366-.037-1.901-.535-.535-1.387-.552-1.902-.038l-10.1 10.101c-.981.982-1.494 2.337-1.494 3.835 0 1.498.513 2.895 1.494 3.875l4.347 4.361c.981.981 2.337 1.494 3.834 1.494 1.498 0 2.853-.513 3.835-1.494l2.609-2.637c.514-.514.496-1.365-.039-1.9s-1.386-.553-1.899-.039zM20.811 13.01H10.666c-.702 0-1.27.604-1.27 1.346s.568 1.346 1.27 1.346h10.145c.701 0 1.27-.604 1.27-1.346s-.569-1.346-1.27-1.346z"/>
          </svg>
        </a>
        <a 
          href={personal.social.hackerrank}
          target="_blank"
          rel="noopener noreferrer"
          class="w-14 h-14 glass-light rounded-xl flex items-center justify-center hover:bg-white/10 transition-all duration-200 group"
          aria-label="HackerRank"
        >
          <svg class="w-6 h-6 text-cosmic-muted group-hover:text-[#00EA64] transition-colors" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c1.285 0 9.75 4.886 10.392 6 .645 1.115.645 10.885 0 12S13.287 24 12 24s-9.75-4.885-10.395-6c-.641-1.115-.641-10.885 0-12C2.25 4.886 10.715 0 12 0zm2.295 6.799c-.141 0-.279.033-.402.099v5.033c.126.069.266.102.402.102.545 0 .987-.452.987-1.012V7.81c0-.56-.443-1.012-.987-1.012zm-4.59 0c-.544 0-.987.452-.987 1.012v3.217c0 .56.443 1.012.987 1.012.141 0 .279-.033.402-.099V6.898c-.126-.069-.266-.102-.402-.102z"/>
          </svg>
        </a>
        <a 
          href={personal.social.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="w-14 h-14 glass-light rounded-xl flex items-center justify-center hover:bg-white/10 transition-all duration-200 group"
          aria-label="Instagram"
        >
          <svg class="w-6 h-6 text-cosmic-muted group-hover:text-[#E4405F] transition-colors" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
          </svg>
        </a>
        <a 
          href={`mailto:${personal.email}`}
          class="w-14 h-14 glass-light rounded-xl flex items-center justify-center hover:bg-white/10 transition-all duration-200 group"
          aria-label="Email"
        >
          <svg class="w-6 h-6 text-cosmic-muted group-hover:text-cosmic-accent transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
