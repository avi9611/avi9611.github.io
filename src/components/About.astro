---
import personal from "../data/personal.json";
---

<section
  id="about"
  class="py-16 px-4 md:px-8 max-w-[1400px] mx-auto bg-paper border-b-4 border-double border-ink"
>
  <div class="text-center mb-12">
    <h2 class="section-header inline-block">Editorial</h2>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start relative">
    <div
      class="absolute left-1/2 top-0 bottom-0 w-px bg-ink/20 -translate-x-1/2 hidden lg:block"
    >
    </div>

    <!-- Content -->
    <div class="space-y-6">
      <h3 class="font-display font-bold text-3xl uppercase leading-tight">
        The Journey So Far: <br />
        <span class="italic font-serif normal-case opacity-80"
          >A developer's perspective</span
        >
      </h3>
      <div class="font-body text-lg leading-relaxed text-justify drop-cap">
        {personal.bio}
      </div>

      <div
        class="border-t border-b border-ink py-4 grid grid-cols-3 divide-x divide-ink/20 font-mono text-center text-xs uppercase tracking-widest mt-8"
      >
        <div class="px-2">
          <span class="block text-2xl font-bold font-display">12+</span>
          <span>Projects</span>
        </div>
        <div class="px-2">
          <span class="block text-2xl font-bold font-display">12+</span>
          <span>Awards</span>
        </div>
        <div class="px-2">
          <span class="block text-2xl font-bold font-display">30+</span>
          <span>Skills</span>
        </div>
      </div>
    </div>

    <!-- Image / Sidebar -->
    <div class="space-y-8">
      <figure class="border border-ink p-1 bg-white inline-block w-full">
        <img
          src={personal.secondaryImage}
          alt={personal.name}
          class="w-full aspect-[4/3] object-cover grayscale contrast-125 block"
          loading="lazy"
        />
        <figcaption
          class="font-mono text-xs mt-1 text-ink-light p-2 border-b border-ink/10"
        >
          Photo: The workspace.
        </figcaption>
      </figure>

      <div class="border border-ink p-6 bg-paper-light">
        <h4 class="font-bold uppercase text-xl mb-4 border-b border-ink pb-2">
          Vitals
        </h4>
        <dl class="grid grid-cols-[100px_1fr] gap-y-2 font-mono text-sm">
          <dt class="font-bold uppercase text-ink/60">Location:</dt>
          <dd>{personal.location}</dd>

          <dt class="font-bold uppercase text-ink/60">Exp:</dt>
          <dd>{personal.experience}</dd>

          <dt class="font-bold uppercase text-ink/60">Focus:</dt>
          <dd>Full Stack Web Dev, Cloud Architecture</dd>
        </dl>
      </div>
    </div>
  </div>
</section>
