---
import projects from '../data/projects.json';

// Show featured projects on homepage
const featuredProjects = projects.filter((project) => project.featured).slice(0, 5);
---

<section
  id="projects"
  class="py-18 border-b-4 border-double border-ink/70 px-4 md:px-8 max-w-[1400px] mx-auto"
>
  <div class="text-center mb-12">
    <h2 class="section-header inline-block">Selected Work</h2>
    <p class="section-lede mt-4">
      A curated set of projects that best reflect delivery quality, product thinking, and engineering depth.
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    {featuredProjects.map((project, index) => (
      <article
        class={`paper-card overflow-hidden ${index === 0 ? "lg:col-span-2" : ""}`}
      >
        <div class={`grid gap-0 ${index === 0 ? "lg:grid-cols-[1.08fr_0.92fr]" : "grid-cols-1"}`}>
          <div class="border-b lg:border-b-0 lg:border-r border-ink/15 p-3">
            <div class="aspect-[16/10] overflow-hidden bg-[rgba(111,99,86,0.08)]">
              <img
              src={project.images[0]}
              alt={project.title}
                class="w-full h-full object-cover grayscale-[0.15] contrast-110 hover:scale-[1.02]"
                loading="lazy"
              />
            </div>
          </div>

          <div class="p-6 md:p-7">
            <div class="flex items-center justify-between gap-4 mb-3">
              <p class="kicker">{project.subtitle}</p>
              <span class="tag-chip">Case Study</span>
            </div>

            <h3 class="font-display text-3xl md:text-4xl font-semibold leading-tight mb-3">
              <a href={`/projects/${project.id}`} class="hover:text-[var(--color-accent)]">
                {project.title}
              </a>
            </h3>

            <p class="text-lg text-ink/85 leading-relaxed mb-5">
              {project.description}
            </p>

            <div class="grid gap-4 mb-5">
              <div class="paper-card p-4">
                <p class="kicker mb-2">Role</p>
                <p class="text-base text-ink/85">{project.role}</p>
              </div>
              <div class="paper-card p-4">
                <p class="kicker mb-2">Outcome</p>
                <p class="text-base text-ink/85">{project.outcome}</p>
              </div>
            </div>

            {project.engagement && (
              <p class="text-sm text-ink-light leading-relaxed mb-5">
                {project.engagement}
              </p>
            )}

            <ul class="space-y-3 mb-6">
              {project.highlights.slice(0, 2).map((highlight: string) => (
                <li class="flex gap-3 items-start">
                  <span class="font-mono text-xs uppercase tracking-[0.16em] text-ink-light pt-1">
                    +
                  </span>
                  <span class="text-base text-ink/80 leading-relaxed">{highlight}</span>
                </li>
              ))}
            </ul>

            <div class="flex flex-wrap gap-2 mb-6">
              {project.tags.slice(0, 5).map((tag: string) => (
                <span class="tag-chip">{tag}</span>
              ))}
            </div>

            <div class="flex flex-wrap gap-4 font-mono text-xs uppercase tracking-[0.18em]">
              <a
                href={`/projects/${project.id}`}
                class="border-b border-ink/30 pb-1 hover:text-[var(--color-accent)] hover:border-[var(--color-accent)]"
              >
                View case study
              </a>
              {project.website && (
                <a
                  href={project.website}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="border-b border-ink/30 pb-1 hover:text-[var(--color-accent)] hover:border-[var(--color-accent)]"
                >
                  Live site
                </a>
              )}
              {project.github && (
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="border-b border-ink/30 pb-1 hover:text-[var(--color-accent)] hover:border-[var(--color-accent)]"
                >
                  View source
                </a>
              )}
            </div>
          </div>
        </div>
      </article>
    ))}
  </div>

  <div class="mt-16 text-center border-t border-ink/20 pt-8">
    <a
      href="/projects"
      class="inline-block btn-news btn-news-secondary"
    >
      View full project archive
    </a>
  </div>
</section>
