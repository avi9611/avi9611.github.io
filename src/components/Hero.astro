---
import personal from "../data/personal.json";
import Duration from "./Duration.astro";
import ActivityStrip from "./ActivityStrip.astro";

const since = personal.currentSinceISO;
const [taglineBefore, taglineAfter] = personal.tagline.split("{duration}");
---

<!-- The point of view leads. The name is in the nav and the title already. -->
<section id="home" class="shell pt-14 pb-16 md:pt-20 md:pb-20">
  <p class="label mb-6">
    {personal.fullName} · {personal.role} · {personal.currentCompanyShort}
  </p>

  <h1
    class="text-[clamp(2.125rem,6.2vw,4.25rem)] font-semibold leading-[1.04] tracking-[-0.035em] max-w-[15ch] [text-wrap:balance]"
  >
    {personal.headline}
  </h1>

  <p class="lede mt-7">
    {taglineBefore}<Duration since={since} style="long" />{taglineAfter}
  </p>

  <div class="mt-9 flex flex-wrap items-center gap-3">
    <a href="#work" class="btn">
      See the work
      <svg
        class="w-3.5 h-3.5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M5 12h14M13 6l6 6-6 6"></path>
      </svg>
    </a>
    <a href={personal.resume} download class="btn btn-ghost">Download CV</a>
  </div>

  <!-- The year of work behind it. -->
  <div class="mt-14 pt-9 border-t border-[var(--rule)]">
    <ActivityStrip />
  </div>
</section>
