---
import "../styles/global.css";
import personal from "../data/personal.json";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = `${personal.name} | Full-Stack Developer & Cloud Enthusiast | Bangalore`,
  description = `${personal.name} is an Entry-Level Full-Stack Developer based in ${personal.location}, specializing in MERN stack, Java Spring Boot, cloud computing (Azure, AWS), and modern web technologies. View portfolio and projects.`,
  image = "/images/avinash.jpg",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// JSON-LD Structured Data for SEO
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: personal.name,
  alternateName: personal.fullName,
  jobTitle: "Full-Stack Developer",
  url: Astro.site?.toString() || "https://avi9611.github.io",
  image: `${Astro.site}images/avinash.jpg`,
  sameAs: [
    personal.social.github,
    personal.social.linkedin,
    personal.social.leetcode,
    personal.social.hackerrank,
    personal.social.geeksforgeeks,
  ],
  address: {
    "@type": "PostalAddress",
    addressLocality: "Bangalore",
    addressRegion: "Karnataka",
    addressCountry: "India",
  },
  email: personal.email,
  telephone: personal.phone,
  knowsAbout: [
    "Web Development",
    "MERN Stack",
    "React.js",
    "Node.js",
    "Java",
    "Spring Boot",
    "Cloud Computing",
    "Azure",
    "AWS",
    "TypeScript",
    "MongoDB",
    "PostgreSQL",
  ],
  alumniOf: {
    "@type": "EducationalOrganization",
    name: "Visvesvaraya Technological University",
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={personal.name} />
    <meta
      name="keywords"
      content="Avinash N, Full Stack Developer, Software Engineer, Portfolio, Newspaper Style"
    />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/jpeg" href="/images/avinash.jpg" />
    <link rel="apple-touch-icon" href="/images/avinash.jpg" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${Astro.site}${image}`} />
    <meta property="og:site_name" content={`${personal.name} Chronicle`} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={`${Astro.site}${image}`} />

    <!-- Additional SEO -->
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow" />
    <meta name="theme-color" content="#121212" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Playfair+Display:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <style is:global>
      /* Paper Grain Animation */
      @keyframes paper-noise {
        0%,
        100% {
          transform: translate(0, 0);
        }
        10% {
          transform: translate(-5%, -5%);
        }
        20% {
          transform: translate(-10%, 5%);
        }
        30% {
          transform: translate(5%, -10%);
        }
        40% {
          transform: translate(-5%, 15%);
        }
        50% {
          transform: translate(10%, -5%);
        }
        60% {
          transform: translate(15%, 0);
        }
        70% {
          transform: translate(0, 10%);
        }
        80% {
          transform: translate(-15%, 0);
        }
        90% {
          transform: translate(10%, 5%);
        }
      }

      .paper-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 50;
        opacity: 0.4;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
        mix-blend-mode: overlay;
      }

      /* Ink Bleed Effect for Text */
      .ink-bleed {
        filter: url(#ink-bleed-filter);
      }

      /* View Transition: Fade through paper color */
      ::view-transition-old(root) {
        animation:
          0.4s cubic-bezier(0.4, 0, 0.2, 1) both fade-out,
          0.4s cubic-bezier(0.4, 0, 0.2, 1) both scale-down;
      }

      ::view-transition-new(root) {
        animation:
          0.4s cubic-bezier(0.4, 0, 0.2, 1) both fade-in,
          0.4s cubic-bezier(0.4, 0, 0.2, 1) both scale-up;
      }

      @keyframes fade-out {
        to {
          opacity: 0;
        }
      }

      @keyframes fade-in {
        from {
          opacity: 0;
        }
      }

      @keyframes scale-down {
        to {
          transform: scale(0.98);
          filter: blur(2px);
        }
      }

      @keyframes scale-up {
        from {
          transform: scale(1.02);
          filter: blur(2px);
        }
      }
    </style>
    <ClientRouter />
  </head>
  <body
    class="bg-paper text-ink antialiased min-h-screen flex flex-col items-center relative overflow-x-hidden selection:bg-ink selection:text-paper"
  >
    <!-- SVG Filters for Effects -->
    <svg style="display: none;">
      <defs>
        <filter id="ink-bleed-filter">
          <feTurbulence
            type="fractalNoise"
            baseFrequency="0.8"
            numOctaves="2"
            result="noise"></feTurbulence>
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="1.5"
          ></feDisplacementMap>
          <feGaussianBlur stdDeviation="0.4"></feGaussianBlur>
        </filter>
      </defs>
    </svg>

    <!-- Grain Overlay -->
    <div class="paper-overlay"></div>

    <div
      class="max-w-[1400px] w-full bg-paper-light min-h-screen shadow-2xl border-x border-ink-light/20 relative z-10"
    >
      <!-- Top decorative line -->
      <div class="h-1 w-full bg-ink-light/10 border-b border-ink/80"></div>

      <slot />

      <!-- Bottom decorative line -->
      <div
        class="h-4 w-full border-t-2 border-ink my-8 border-b border-ink-light/20"
      >
      </div>
    </div>
  </body>
</html>
