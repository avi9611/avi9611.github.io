---
// A toy purchasing flow that acts out two rules from the calibration CRM: a sent
// document keeps the facts it was sent with, and the audit log only ever grows.
// The vendor and the orders are invented. Nothing here is client code.

const vendor = "Northwind Metrology Supplies LLC";
const seedAddress = "Office 402, Al Qusais Industrial Area 2, Dubai";

const seedLog = [
  { when: "3 Mar, 09:10", actor: "procurement@dubai", action: "po.create", target: "PO-0142", detail: "" },
  { when: "3 Mar, 09:12", actor: "procurement@dubai", action: "po.issue", target: "PO-0142", detail: "vendor snapshot taken" },
  { when: "5 Mar, 11:40", actor: "procurement@dubai", action: "po.create", target: "PO-0143", detail: "" },
];

const orders = [
  {
    id: "PO-0142",
    state: "issued",
    issued: "Issued 3 Mar 2026",
    source: "Vendor · snapshot, 3 Mar 2026",
    action: { act: "edit", label: "Change the vendor on this order" },
    lines: [
      { item: "Reference weight set, class M1", qty: "1 × AED 6,400.00", amount: "AED 6,400.00" },
      { item: "Digital manometer", qty: "2 × AED 3,025.00", amount: "AED 6,050.00" },
    ],
    total: "AED 12,450.00",
  },
  {
    id: "PO-0143",
    state: "draft",
    issued: "Not issued yet",
    source: "Vendor · live from the vendor record",
    action: { act: "issue", label: "Issue this order" },
    lines: [
      { item: "Temperature data logger", qty: "4 × AED 1,180.00", amount: "AED 4,720.00" },
      { item: "Thermocouple probe, type K", qty: "6 × AED 215.50", amount: "AED 1,293.00" },
    ],
    total: "AED 6,013.00",
  },
];
---

<div
  id="try"
  class="mt-16 md:mt-20"
  data-break-it
  data-seed-address={seedAddress}
  data-seed-log={JSON.stringify(seedLog)}
>
  <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-4 mb-6">
    <div>
      <h3 class="text-[1.375rem] font-semibold tracking-[-0.02em] text-[var(--ink)]">
        Try to break it
      </h3>
      <p class="mt-2 text-[var(--ink-soft)] max-w-[42rem] leading-relaxed">
        A toy purchasing flow built on the third decision. Move the vendor, issue
        the draft, then try to change an order that has already gone out, or
        delete a line from the audit log.
      </p>
    </div>
    <button type="button" class="btn btn-ghost" data-reset>Start over</button>
  </div>

  <div class="card overflow-clip">
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-px bg-[var(--rule)]">
      <section class="bg-[var(--surface)] p-5 md:col-span-2 lg:col-span-1" aria-labelledby="demo-vendor">
        <p class="label">Vendor record · live</p>
        <h4 id="demo-vendor" class="mt-3 font-semibold text-[var(--ink)] leading-snug">{vendor}</h4>
        <form class="mt-4" data-vendor-form>
          <label for="demo-address" class="block text-[0.8125rem] text-[var(--ink-soft)] mb-1.5">
            Address
          </label>
          <textarea id="demo-address" rows="3" maxlength="120" class="field">{seedAddress}</textarea>
          <div class="mt-3 flex flex-wrap gap-2">
            <button type="submit" class="btn small">Save address</button>
            <button type="button" class="btn btn-ghost small" data-move>Move office</button>
          </div>
        </form>
      </section>

      {
        orders.map((o) => (
          <article class="doc bg-[var(--raised)] p-5 flex flex-col" data-doc={o.id} data-state={o.state}>
            <header class="flex items-start justify-between gap-3">
              <div>
                <p class="font-mono text-[0.9375rem] font-medium text-[var(--ink)]">{o.id}</p>
                <p class="mt-1 text-[0.8125rem] text-[var(--ink-soft)]">
                  Dubai branch · <span data-issued>{o.issued}</span>
                </p>
              </div>
              <span class="stamp" data-stamp>{o.state === "issued" ? "Issued" : "Draft"}</span>
            </header>

            <div class="vendor mt-4 -mx-2 px-2 py-2 rounded-[3px]" data-vendor-block>
              <p class="label !text-[0.625rem]" data-source>{o.source}</p>
              <p class="mt-1.5 text-[0.875rem] font-medium text-[var(--ink)]">{vendor}</p>
              <p class="text-[0.875rem] text-[var(--ink-mid)] leading-snug" data-address>{seedAddress}</p>
              <p class="drift mt-2 text-[0.8125rem] leading-snug" data-drift hidden>
                The vendor record has changed since this was issued. This order keeps what was sent.
              </p>
            </div>

            <ul class="mt-4 text-[0.8125rem] border-t border-[var(--rule-soft)]">
              {o.lines.map((l) => (
                <li class="flex items-start justify-between gap-3 py-2 border-b border-[var(--rule-soft)]">
                  <span class="min-w-0">
                    <span class="block text-[var(--ink)]">{l.item}</span>
                    <span class="block text-[var(--ink-faint)] tabular-nums">{l.qty}</span>
                  </span>
                  <span class="shrink-0 tabular-nums text-[var(--ink-mid)]">{l.amount}</span>
                </li>
              ))}
              <li class="flex justify-between gap-3 pt-2.5 font-semibold text-[var(--ink)] tabular-nums">
                <span>Total</span>
                <span>{o.total}</span>
              </li>
            </ul>

            <div class="mt-auto pt-5">
              <button type="button" class="btn btn-ghost small" data-act={o.action.act}>
                {o.action.label}
              </button>
            </div>
          </article>
        ))
      }
    </div>

    <p class="status" role="status" aria-live="polite" data-status data-tone="info">
      Change the vendor's address, issue the draft, or try to change something that has already gone out.
    </p>

    <div class="border-t border-[var(--rule)] bg-[var(--surface)] p-5">
      <div class="flex items-baseline justify-between gap-4 mb-3">
        <p class="label">Audit log · append-only</p>
        <p class="label tabular-nums" data-count>{seedLog.length} entries</p>
      </div>
      <ol class="log" data-log>
        {
          seedLog.map((e, i) => (
            <li class="entry">
              <span class="when">{e.when}</span>
              <span class="actor">{e.actor}</span>
              <span class="action">{e.action}</span>
              <span class="target">
                {e.target}
                {e.detail && <span class="detail"> · {e.detail}</span>}
              </span>
              <button type="button" class="del" data-entry={i} aria-label={`Delete entry ${i + 1} from the audit log`}>
                Delete
              </button>
            </li>
          ))
        }
      </ol>
    </div>
  </div>

  <p class="mt-4 text-[0.875rem] text-[var(--ink-soft)] leading-relaxed">
    Made for this page; the vendor and the orders are invented. The rule is the
    one the <a href="/projects/calibration-crm" class="link-underline">calibration CRM</a> runs on.
  </p>
</div>

<style>
  .small {
    padding: 0.4375rem 0.75rem;
    font-size: 0.8125rem;
  }

  .field {
    display: block;
    width: 100%;
    resize: vertical;
    padding: 0.5rem 0.625rem;
    font: inherit;
    /* 16px on phones, or iOS zooms the page when the field takes focus. */
    font-size: 1rem;
    line-height: 1.45;
    color: var(--ink);
    background: var(--raised);
    border: 1px solid var(--rule);
    border-radius: 3px;
  }

  @media (min-width: 768px) {
    .field { font-size: 0.875rem; }
  }

  .field:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .stamp {
    flex-shrink: 0;
    padding: 0.3125rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1.5px solid currentColor;
    border-radius: 3px;
    transform: rotate(-4deg);
  }

  [data-state="draft"] .stamp {
    color: var(--ink-faint);
    border-style: dashed;
    transform: none;
  }

  .drift { color: var(--accent); }

  .flash { animation: flash 1.2s ease-out; }

  @keyframes flash {
    from { background: var(--accent-dim); }
    to { background: transparent; }
  }

  @media (prefers-reduced-motion: reduce) {
    .flash { animation: none; }
  }

  .status {
    padding: 0.875rem 1.25rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--ink-mid);
    background: var(--raised);
    border-top: 1px solid var(--rule);
  }

  /* Stacked on phones and tablets, the result of a tap can be a screen away from
     the button, so the message stays in view while the demo is. */
  @media (max-width: 1023px) {
    .status {
      position: sticky;
      bottom: 0;
      z-index: 1;
      padding-bottom: max(0.875rem, env(safe-area-inset-bottom));
      border-bottom: 1px solid var(--rule);
      box-shadow: 0 -6px 16px rgb(0 0 0 / 0.06);
    }
  }

  .status :global(strong) { font-weight: 600; color: var(--ink); }
  .status[data-tone="ok"] :global(strong) { color: var(--accent); }
  .status[data-tone="deny"] { background: var(--deny-dim); }
  .status[data-tone="deny"] :global(strong) { color: var(--deny); }

  .log {
    max-height: 15rem;
    overflow-y: auto;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    border-top: 1px solid var(--rule);
  }

  .log :global(.entry) {
    display: grid;
    grid-template-columns: 6.5rem 1fr auto;
    gap: 0.125rem 0.75rem;
    align-items: baseline;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--rule-soft);
    color: var(--ink-mid);
  }

  /* Phones: time and actor on one line, the event on the next. */
  .log :global(.when) { color: var(--ink-faint); }
  .log :global(.actor) { color: var(--ink-soft); min-width: 0; overflow-wrap: anywhere; }
  .log :global(.action) { grid-column: 1; color: var(--ink); }
  .log :global(.target) { grid-column: 2 / 4; min-width: 0; overflow-wrap: anywhere; }
  .log :global(.del) { grid-column: 3; grid-row: 1; }

  @media (min-width: 768px) {
    .log :global(.entry) { grid-template-columns: 6.5rem 9rem 10rem 1fr auto; }
    .log :global(.action) { grid-column: auto; }
    .log :global(.target) { grid-column: auto; }
    .log :global(.del) { grid-column: auto; grid-row: auto; }
  }

  .log :global(.detail) { color: var(--ink-faint); }

  .log :global(.entry[data-denied] .action) { color: var(--deny); }
  .log :global(.entry[data-denied] .action)::after {
    content: " denied";
  }

  .log :global(.entry[data-new]) { animation: flash 1.2s ease-out; }

  @media (prefers-reduced-motion: reduce) {
    .log :global(.entry[data-new]) { animation: none; }
  }

  .log :global(.del) {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--ink-faint);
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 0.2em;
  }

  .log :global(.del:hover) { color: var(--deny); text-decoration-color: currentColor; }
</style>

<script>
  interface Entry {
    when: string;
    actor: string;
    action: string;
    target: string;
    detail: string;
    denied?: boolean;
  }

  type Tone = "info" | "ok" | "deny";

  const MOVES = [
    "Warehouse 7, Dubai Investments Park, Dubai",
    "Unit 12, Al Jaddaf Business Centre, Dubai",
    "Office 1103, Business Bay, Dubai",
  ];

  const INTRO =
    "Change the vendor's address, issue the draft, or try to change something that has already gone out.";

  const now = () =>
    "Today, " + new Date().toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit" });

  function setup(root: HTMLElement) {
    if (root.dataset.bound === "1") return;
    root.dataset.bound = "1";

    const seedAddress = root.dataset.seedAddress ?? "";
    const seedLog: Entry[] = JSON.parse(root.dataset.seedLog ?? "[]");

    const field = root.querySelector<HTMLTextAreaElement>("#demo-address")!;
    const status = root.querySelector<HTMLElement>("[data-status]")!;
    const log = root.querySelector<HTMLOListElement>("[data-log]")!;
    const count = root.querySelector<HTMLElement>("[data-count]")!;
    const sent = root.querySelector<HTMLElement>('[data-doc="PO-0142"]')!;
    const draft = root.querySelector<HTMLElement>('[data-doc="PO-0143"]')!;
    const part = (doc: HTMLElement, name: string) =>
      doc.querySelector<HTMLElement>(`[data-${name}]`)!;

    const fresh = () => ({
      address: seedAddress,
      moves: 0,
      // When PO-0143 was issued, and the address it was issued with.
      issuedAt: null as string | null,
      snapshot: "",
      entries: seedLog.length,
    });
    let s = fresh();

    function say(tone: Tone, lead: string, text: string) {
      status.dataset.tone = tone;
      const strong = document.createElement("strong");
      strong.textContent = lead;
      status.replaceChildren(...(lead ? [strong, " "] : []), text);
    }

    function row(e: Entry, index: number) {
      const li = document.createElement("li");
      li.className = "entry";
      if (e.denied) li.dataset.denied = "";
      const cell = (cls: string, text: string) => {
        const span = document.createElement("span");
        span.className = cls;
        span.textContent = text;
        return span;
      };
      const target = cell("target", e.target);
      if (e.detail) target.append(cell("detail", ` · ${e.detail}`));
      const del = document.createElement("button");
      del.type = "button";
      del.className = "del";
      del.textContent = "Delete";
      del.dataset.entry = String(index);
      del.setAttribute("aria-label", `Delete entry ${index + 1} from the audit log`);
      li.append(cell("when", e.when), cell("actor", e.actor), cell("action", e.action), target, del);
      return li;
    }

    // Append-only here too: rows are added, never rewritten, so focus stays put.
    function append(e: Omit<Entry, "when" | "actor"> & { when?: string }) {
      const li = row({ when: now(), actor: "you", ...e }, s.entries);
      li.dataset.new = "";
      log.append(li);
      s.entries += 1;
      count.textContent = `${s.entries} entries`;
      log.scrollTop = log.scrollHeight;
    }

    function renderDraft() {
      const issued = s.issuedAt !== null;
      draft.dataset.state = issued ? "issued" : "draft";
      part(draft, "stamp").textContent = issued ? "Issued" : "Draft";
      part(draft, "issued").textContent = issued ? `Issued ${s.issuedAt!.toLowerCase()}` : "Not issued yet";
      part(draft, "source").textContent = issued
        ? `Vendor · snapshot, ${s.issuedAt!.toLowerCase()}`
        : "Vendor · live from the vendor record";
      part(draft, "address").textContent = issued ? s.snapshot : s.address;
      part(draft, "drift").hidden = !issued || s.snapshot === s.address;
      const button = part(draft, "act");
      button.dataset.act = issued ? "edit" : "issue";
      button.textContent = issued ? "Change the vendor on this order" : "Issue this order";
    }

    function render() {
      part(sent, "drift").hidden = s.address === seedAddress;
      renderDraft();
    }

    function flash(el: HTMLElement) {
      el.classList.remove("flash");
      void el.offsetWidth;
      el.classList.add("flash");
    }

    function save(raw: string) {
      const next = raw.trim().replace(/\s+/g, " ");
      if (!next) return say("deny", "Refused.", "A vendor needs an address.");
      if (next === s.address) {
        return say("info", "Nothing changed.", "Edit the address first, or press Move office.");
      }
      s.address = next;
      field.value = next;
      append({ action: "vendor.update", target: "Northwind Metrology", detail: `address set to "${next}"` });
      render();
      if (s.issuedAt === null) {
        flash(part(draft, "vendor-block"));
        say("ok", "Saved.", "The draft follows the vendor record. PO-0142 keeps the address it was sent with.");
      } else {
        say("ok", "Saved.", "Both orders were issued before this change, so neither one moves.");
      }
    }

    function issue() {
      const when = now();
      s.issuedAt = when;
      s.snapshot = s.address;
      append({ when, action: "po.issue", target: "PO-0143", detail: "vendor snapshot taken" });
      render();
      say(
        "ok",
        "Issued.",
        `PO-0143 now keeps the vendor's details as they were at ${when.slice(7)}. Move the vendor again and watch it stay put.`,
      );
    }

    function refuseEdit(id: string) {
      append({ action: "po.update", target: id, detail: "issued documents are read-only", denied: true });
      const when = id === "PO-0142" ? "on 3 Mar 2026" : "today";
      say(
        "deny",
        "Refused.",
        `${id} was issued ${when} and has left the building. A change means an amendment, not an edit. The attempt is in the audit log.`,
      );
    }

    function refuseDelete(index: number) {
      append({
        action: "audit.delete",
        target: `entry ${index + 1}`,
        detail: "the log has no delete path",
        denied: true,
      });
      say(
        "deny",
        "Refused.",
        "Nothing in the application can update or delete an audit entry. Your attempt to delete one is now an entry of its own.",
      );
    }

    function reset() {
      s = fresh();
      field.value = seedAddress;
      log.replaceChildren(...seedLog.map(row));
      count.textContent = `${s.entries} entries`;
      render();
      say("info", "", INTRO);
    }

    root.addEventListener("submit", (event) => {
      event.preventDefault();
      save(field.value);
    });

    root.addEventListener("click", (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>("button");
      if (!button || !root.contains(button)) return;

      if (button.matches("[data-move]")) {
        // The next preset address that differs from the current one.
        let next = MOVES[0];
        for (let i = 0; i < MOVES.length; i++) {
          const candidate = MOVES[(s.moves + i) % MOVES.length];
          if (candidate !== s.address) {
            next = candidate;
            s.moves += i + 1;
            break;
          }
        }
        save(next);
      } else if (button.matches("[data-reset]")) {
        reset();
      } else if (button.dataset.act === "issue") {
        issue();
      } else if (button.dataset.act === "edit") {
        refuseEdit(button.closest<HTMLElement>("[data-doc]")!.dataset.doc!);
      } else if (button.dataset.entry !== undefined) {
        refuseDelete(Number(button.dataset.entry));
      }
    });
  }

  function init() {
    document.querySelectorAll<HTMLElement>("[data-break-it]").forEach(setup);
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>
