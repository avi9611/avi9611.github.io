---
import certificates from "../data/certificates.json";
---

<section
  id="certificates"
  class="py-16 px-4 md:px-8 max-w-[1400px] mx-auto bg-paper border-b-4 border-double border-ink"
>
  <div class="text-center mb-12">
    <h2 class="section-header inline-block">Distinctions & Awards</h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    {
      certificates.map((cert) => (
        <article class="border border-ink p-6 relative bg-paper-light">
          <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-paper px-2 border border-ink font-mono text-xs uppercase font-bold">
            Certified
          </div>

          <h3 class="font-display font-bold text-xl uppercase mb-2 text-center mt-2">
            {cert.title}
          </h3>
          <p class="font-mono text-xs uppercase text-center text-ink-light mb-4 border-b border-ink/20 pb-2">
            Issued by {cert.issuer}
          </p>

          <p class="text-justify font-body text-sm leading-relaxed text-ink/80 mb-6">
            {cert.description}
          </p>

          <div class="text-center">
            <a
              href={cert.link}
              target="_blank"
              class="inline-block border border-ink px-4 py-2 font-mono text-xs uppercase hover:bg-ink hover:text-paper transition-colors"
            >
              View Credential
            </a>
          </div>
        </article>
      ))
    }
  </div>
</section>
