---
import personal from "../data/personal.json";

const navItems = [
  { href: "#home", label: "Overview" },
  { href: "#about", label: "Profile" },
  { href: "#experience", label: "Experience" },
  { href: "#projects", label: "Work" },
  { href: "#skills", label: "Capabilities" },
  { href: "#contact", label: "Contact" },
];
---

<nav
  id="navbar"
  class="sticky top-0 z-50 bg-paper-light/95 backdrop-blur border-y border-ink/20 w-full"
>
  <div class="max-w-[1400px] mx-auto px-4 md:px-8 py-3 flex justify-between items-center gap-4">
    <a
      href="#home"
      class="font-mono text-[11px] md:text-xs uppercase tracking-[0.28em] text-ink-light hover:text-ink"
    >
      {personal.name} / Portfolio
    </a>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-btn"
      class="lg:hidden px-3 py-2 text-ink border border-ink/30 font-mono text-xs uppercase tracking-[0.2em]"
      aria-label="Menu"
    >
      <span class="block">Menu</span>
    </button>

    <!-- Desktop Navigation -->
    <div
      class="hidden lg:flex items-center gap-2"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="px-4 py-2 font-mono text-xs uppercase tracking-[0.22em] text-ink-light hover:text-ink hover:bg-white/40"
          >
            {item.label}
          </a>
        ))
      }
    </div>

    <!-- Mobile Menu Overlay -->
    <div
      id="mobile-menu"
      class="absolute top-full left-0 w-full bg-paper-light border-b border-ink/20 hidden flex-col"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="block py-4 px-6 text-left font-mono text-xs uppercase tracking-[0.22em] border-b border-ink/10 hover:bg-white/40"
          >
            {item.label}
          </a>
        ))
      }
    </div>
  </div>
</nav>

<script>
  const mobileMenuBtn = document.getElementById("mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");

  mobileMenuBtn?.addEventListener("click", () => {
    mobileMenu?.classList.toggle("hidden");
  });
</script>
