---
import projects from '../data/projects.json';

// Show featured projects on homepage
const featuredProjects = projects.filter(p => p.featured).slice(0, 6);
---

<section id="projects" class="py-16 border-b-4 border-double border-ink bg-paper px-4 md:px-8 max-w-[1400px] mx-auto">
  
  <div class="text-center mb-12">
    <h2 class="section-header inline-block">Featured Stories</h2>
    <p class="font-body italic text-ink/70 max-w-2xl mx-auto">
      Investigative reports on the latest software developments and engineering feats.
    </p>
  </div>
    
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-12 divide-y md:divide-y-0 md:divide-x divide-ink/20">
    {featuredProjects.map((project, index) => (
      <article class={`flex flex-col h-full ${index > 0 ? 'pt-8 md:pt-0 md:pl-8' : ''}`}>
        
        <!-- Image -->
        <div class="mb-4 border border-ink p-1 bg-white relative group overflow-hidden">
          <div class="aspect-video w-full overflow-hidden bg-gray-200">
            <img 
              src={project.images[0]}
              alt={project.title}
              class="w-full h-full object-cover grayscale contrast-125 group-hover:grayscale-0 transition-all duration-500"
              loading="lazy"
            />
          </div>
          {/* Tag Overlay */}
          <div class="absolute top-2 right-2 bg-paper border border-ink px-2 py-0.5 z-10">
            <span class="font-mono text-xs font-bold uppercase text-white bg-black px-1">{project.subtitle || "FEATURE"}</span>
          </div>
        </div>

        <!-- Headline -->
        <h3 class="font-display text-2xl font-bold leading-tight mb-2 hover:underline decoration-2 underline-offset-2">
          <a href={project.github} target="_blank">{project.title}</a>
        </h3>

        <!-- Meta Data line -->
        <div class="border-t border-b border-ink/30 py-1 mb-3 flex flex-wrap gap-2 items-center text-xs font-mono uppercase tracking-wide text-ink-light">
          <span class="font-bold text-ink">Tech:</span>
          {project.tags.slice(0, 3).map((tag: string) => (
            <span>{tag}</span>
          ))}
          {project.tags.length > 3 && <span>& {project.tags.length - 3} more</span>}
        </div>
        
        <!-- Subtitle/Lead -->
        <p class="font-display font-medium italic mb-2 text-ink/90">
          {project.subtitle}
        </p>

        <!-- Body -->
        <p class="font-body text-sm leading-relaxed text-justify text-ink/80 mb-4 flex-grow">
          {project.description}
        </p>
        
        <!-- Footer Links -->
        <div class="mt-auto pt-4 flex items-center justify-between font-mono text-xs uppercase font-bold tracking-widest border-t border-ink/10">
          <a href={project.github} target="_blank" class="hover:bg-ink hover:text-paper px-2 py-1 transition-colors border border-transparent hover:border-ink">
            [ Source Code ]
          </a>
        </div>

      </article>
    ))}
  </div>
    
  <!-- Pagination / See More -->
  <div class="mt-16 text-center border-t border-ink pt-8">
    <a href="/projects" class="inline-block border-2 border-ink px-8 py-3 font-display font-bold uppercase hover:bg-ink hover:text-paper transition-all text-xl tracking-widest">
      See Full Archive
    </a>
  </div>

</section>
