---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import projects from '../../data/projects.json';
---

<Layout 
  title="Project Archive - Avinash Neralakatte | Full-Stack Engineer"
  description="Explore selected projects by Avinash Neralakatte across product interfaces, backend-heavy builds, AI-assisted workflows, and client-facing web delivery."
>
  <Navigation />
  
  <main class="pt-24 pb-24 min-h-screen">
    <div class="max-w-[1400px] mx-auto px-4 md:px-8">
      <div class="text-center mb-14">
        <a
          href="/"
          class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.2em] text-ink-light hover:text-ink mb-6"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          Back to portfolio
        </a>
        <h1 class="section-header inline-block">Project Archive</h1>
        <p class="section-lede mt-4">
          A broader view of the projects that shaped my product thinking, implementation style, and technical range.
        </p>
      </div>
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        {projects.map((project) => (
          <article class="paper-card overflow-hidden">
            <div class="grid md:grid-cols-[220px_1fr] gap-0 h-full">
              <div class="p-3 border-b md:border-b-0 md:border-r border-ink/15">
                <div class="h-full min-h-52 overflow-hidden bg-[rgba(111,99,86,0.08)]">
                  <img 
                src={project.images[0]}
                alt={project.title}
                    class="w-full h-full object-cover grayscale-[0.12] contrast-110 hover:scale-[1.02]"
                loading="lazy"
              />
                </div>
              </div>
              
              <div class="p-6 md:p-7 flex flex-col">
                <div class="flex items-center justify-between gap-4 mb-3">
                  <p class="kicker">{project.subtitle}</p>
                  {project.featured && <span class="tag-chip">Featured</span>}
                </div>

                <h2 class="font-display text-3xl font-semibold leading-tight mb-3">
                  <a href={`/projects/${project.id}`} class="hover:text-[var(--color-accent)]">
                    {project.title}
                  </a>
                </h2>

                <p class="text-base text-ink/80 leading-relaxed mb-4">{project.description}</p>

                <p class="text-sm text-ink-light mb-5">{project.role}</p>

                <div class="flex flex-wrap gap-2 mb-6">
                  {project.tags.slice(0, 5).map((tag: string) => (
                    <span class="tag-chip">
                    {tag}
                  </span>
                ))}
                </div>

                <div class="mt-auto flex flex-wrap gap-5 font-mono text-xs uppercase tracking-[0.18em]">
                  <a
                    href={`/projects/${project.id}`}
                    class="border-b border-ink/30 pb-1 hover:text-[var(--color-accent)] hover:border-[var(--color-accent)]"
                  >
                    View case study
                  </a>
                  {project.website && (
                    <a
                      href={project.website}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="border-b border-ink/30 pb-1 hover:text-[var(--color-accent)] hover:border-[var(--color-accent)]"
                    >
                      Live site
                    </a>
                  )}
                  <a
                    href={project.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="border-b border-ink/30 pb-1 hover:text-[var(--color-accent)] hover:border-[var(--color-accent)]"
                  >
                    View source
                  </a>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </main>
  
  <Footer />
</Layout>
